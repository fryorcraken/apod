#compdef apod
# zsh completion for apod. Link this file into a directory on $fpath,
# e.g. ln -s ~/src/rad/apod/_apod ~/.oh-my-zsh/custom/completions/_apod

_apod_profiles() {
  # profiles/*.toml in apod's config folder (the folders of ~/.agent-pod in the legacy layout)
  local -a profiles
  profiles=(${(f)"$(apod --list-profiles 2>/dev/null)"})
  _describe -t profiles 'profile' profiles
}

_apod_first() {
  local -a cmds
  cmds=('new:create a profile, step by step' 'migrate:move a profile'"'"'s old files into one profile.toml (--layout: ~/.agent-pod to the new layout)'
        'token:set, replace or remove a profile GitHub token' 'profiles:list profiles and token status'
        'presets:list presets: pod settings, role and scope any profile can launch with (-p)'
        'google-auth:sign a profile in to Google for google-docs-mcp'
        'resume:resume a stopped Claude session started in a folder (this pane'"'"'s, or pick)'
        'history:folders and profiles launched, most recent first'
        'ps:running pods with their profile, folder and session'
        'broker:the broker: approvals, request log, sessions, keys'
        'selinux:let broker and ssh-agent pods keep SELinux labelling (install, remove, status)')
  _describe -t commands 'command' cmds
  _apod_profiles
}

_apod_presets() {
  # presets/*.toml in apod's config folder
  local -a presets
  presets=(${(f)"$(apod --list-presets 2>/dev/null)"})
  (( ${#presets} )) && _values -s , 'preset' $presets
}

_apod_roles() {
  local -a roles
  roles=(${(f)"$(apod --list-roles 2>/dev/null)"})
  _describe -t roles 'role' roles
}

_apod_images() {
  local -a images
  images=(${(f)"$(podman images --format '{{.Repository}}' 2>/dev/null | sed 's|^localhost/||' | sort -u)"})
  _describe -t images 'image' images
}

_apod_connectors() {
  local -a groups
  groups=(none ${(f)"$(apod --list-connectors 2>/dev/null)"})
  _values -s , 'connector' $groups
}

# The launch options (apod resume takes them too, but -a), also listed with the folders on a bare
# <TAB> after the profile (the folder is optional, and _arguments alone offers options only once
# the word starts with -).
launchopts=(
  '-a[agent to run]:agent:(claude opencode bash)'
  '*'{-p,--preset}'[a preset: image, mounts, network, volumes, env, role, scope]:presets:_apod_presets'
  '(-i --image)'{-i,--image}'[container image for this run]:image:_apod_images'
  '*'{-c,--connectors}'[enable claude.ai connectors for this run]:connectors:_apod_connectors'
  '*'{-m,--ro}'[mount a file or folder read-only]:path:_files'
  '*--rw[mount a file or folder read-write]:path:_files'
  '--role[use the broker with this role (default: from profile.toml, else reader)]:role:_apod_roles'
  '--no-broker[no broker for this run, even for a profile that uses it]'
  '--gh-user[use the broker, acting on GitHub as this host gh account]:account:'
  '*--scope[use the broker, adding to its scope (gh:OWNER/REPO, gh:OWNER/*, gh:OWNER, gh-project:OWNER/N, rad:RID, ssh:USER@HOST or ssh:HOST, git-local:PATH)]:scope:'
)

case ${words[2]} in
  token)    _arguments '1: :(token)' '2:profile:_apod_profiles' '3:option:(--rm)'; return ;;
  google-auth) _arguments '1: :(google-auth)' '2:profile:_apod_profiles'; return ;;
  new)      return ;;
  migrate)  _arguments '1: :(migrate)' '2:profile:{_apod_profiles; compadd -- --all --layout}' \
              '3:profile or option:{[[ $words[3] == --layout ]] && _path_files -W "${APOD_ROOT:-$HOME/.agent-pod}" -/; compadd -- --yes}' \
              '4:option:(--yes)'; return ;;
  resume)   _arguments '1: :(resume)' '(--latest --claude)--list[always list and ask]' \
              '(--list --claude)--latest[resume the newest without asking]' \
              '(--list --latest)--claude[use Claude'"'"'s own session picker]' '2:folder:_directories' \
              ${launchopts:#-a\[*}; return ;;
  profiles|presets|history|ps) return ;;
  selinux)  _arguments '1: :(selinux)' '2:action:(install remove status)'; return ;;
  broker|gh)
    if (( CURRENT == 3 )); then
      local -a sub
      sub=('ui:terminal UI to approve requests (also plain apod broker)' 'log:recent requests (-f to follow, -n N)'
           'pending:requests waiting for approval' 'allow:approve a request (--session, --role)'
           'deny:deny a waiting request' 'sessions:sessions with their role and scope'
           'roles:what each role adds to the ones it extends; with NAME, all it allows' 'scopes:scope kinds the extensions provide' 'extensions:the extensions; with NAME, its guide and what roles allow' 'grants:approvals saved for roles (rm ROLE ACTION)'
           'keys:load keys the sessions use into the broker agent (after a restart)'
           'restart:restart the broker (sessions are kept)' 'stop:stop the broker')
      _describe -t commands 'broker command' sub
    elif [[ ${words[3]} == extensions ]] && (( CURRENT == 4 )); then
      local -a exts
      exts=(${(f)"$(apod broker extensions 2>/dev/null | awk 'NF && $1 != "apod" {print $1}')"})
      _describe -t extensions 'extension' exts
    elif [[ ${words[3]} == roles ]] && (( CURRENT == 4 )); then
      _apod_roles
    elif [[ ${words[3]} == allow ]]; then
      _arguments '3:request id:' '4:scope:(--session --role)'
    fi
    return ;;
esac

_apod_dir() {
  _directories
  [[ -n $PREFIX ]] && return
  local -a opts; local spec name
  for spec in $launchopts; do
    name=${${spec#\(*\)}#\*}; name=${name%%\[*}
    # an option that can't repeat is offered once
    [[ $spec != \** && -n ${words[(r)$name]} ]] && continue
    opts+=("$name:${${spec#*\[}%%\]*}")
  done
  _describe -t launch-options 'option' opts
}

_arguments -s -S '1:profile:_apod_first' '2:project dir:_apod_dir' $launchopts
