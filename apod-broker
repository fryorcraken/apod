 <td class=${cls(e.decision)}>${esc(e.decision)}${e.exit!=null&&e.exit!==0?` (exit ${e.exit})`:''}</td>
 <td>${/^(rejected|timed|denied by)/.test(e.decision)&&(e.missing.length||e.out.length)?btns(e,false):''}</td></tr>`).join('');
}
load();setInterval(load,2000);
</script>"""


