 ${x.grants.actions.length+x.grants.unscoped.length?`<div>granted: ${[...x.grants.actions,...x.grants.unscoped].map(v=>`<span class="tag x" title="remove" onclick="post('/api/scope/remove',{session:'${x.id}',value:${esc(JSON.stringify(v))}})">${esc(v)}</span>`).join('')}</div>`:''}</div>`).join('')||'<div class=mute>No sessions.</div>';
