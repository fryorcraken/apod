#!/usr/bin/env python3
"""apod-notify [--urgent] TEXT...: a desktop notification for the user, through the apod broker
(the pod side of extensions/notify.py). Blocks while the request waits for approval."""
import http.client
import json
import os
import socket
import sys


class UnixHTTP(http.client.HTTPConnection):
    def __init__(self):
        super().__init__("localhost")

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(os.environ.get("APOD_BROKER_SOCK", "/run/apod-broker/broker.sock"))


def main(args):
    urgent = "--urgent" in args
    args = [a for a in args if a != "--urgent"]
    if not args:
        return "usage: apod-notify [--urgent] TEXT"
    try:
        c = UnixHTTP()
        c.request("POST", "/notify", json.dumps({"text": " ".join(args), "urgent": urgent}),
                  {"Content-Type": "application/json"})
        r = c.getresponse()
        out = json.loads(r.read() or b"{}")
    except (OSError, ValueError) as e:
        return f"apod-notify: can't reach the apod broker: {e}"
    if r.status != 200:
        return f"apod-notify: {out.get('error', r.status)}"
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
