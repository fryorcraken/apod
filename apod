    SSH_AUTH_SOCK=$agentsock ssh-add "${addopts[@]}" "$kpath" < "$ttyin" || echo "apod: couldn't load $kpath into the broker's agent" >&2
  done < <(jq -r '.need_keys[] | [.path, .confirm, ((.purpose // []) | join(", "))] | @tsv' <<< "$binfo")
  mounts+=(-v "$(jq -r .dir <<< "$binfo"):$(jq -r .pod_dir <<< "$binfo"):z"
    -v "$apoddir/broker/pod-shim:/usr/local/bin/apod-git-forward:ro,z")
  while IFS=$'\t' read -r src dst mode; do mounts+=(-v "$src:$dst:$mode,z"); done < <(jq -r '.mounts[] | @tsv' <<< "$binfo")
  # Host names, network sysctls and commands to start before the agent, from extensions (gh-api:
  # api.github.com through the broker).
  while IFS=$'\t' read -r n a; do podopts+=(--add-host "$n:$a"); done < <(jq -r '(.hosts // {}) | to_entries[] | [.key, .value] | @tsv' <<< "$binfo")
  while IFS=$'\t' read -r k v; do podopts+=(--sysctl "$k=$v"); done < <(jq -r '(.sysctls // {}) | to_entries[] | [.key, .value] | @tsv' <<< "$binfo")
  while IFS= read -r c; do
    mapfile -t argv < <(jq -r '.[]' <<< "$c")
    startcmds+="$(printf '%q ' "${argv[@]}")|| echo \"apod: ${argv[0]} did not start\" >&2"$'\n'
  done < <(jq -c '(.start // [])[]' <<< "$binfo")
  if [[ $bproviders == *" ssh "* ]] && [ -n "$sshkey" ]; then
    echo "apod: profile.toml has [ssh], so its [ssh-agent] key is ignored" >&2; sshkey=
  fi
fi

# Tell the agent where it is and what it can see (Claude: appended to its system prompt).
pnote=; [ ${#presets[@]} -eq 0 ] || pnote=", preset$([ ${#presets[@]} -gt 1 ] && echo s) $(IFS=,; echo "${presets[*]}")"
context="You are running inside an apod container (podman), profile \"$profile\"$pnote. Only these host paths are mounted:
- $proj (read-write, the project)"
for p in "${rwmounts[@]}"; do
  if [ "$p" = "$gitcommon" ]; then context+=$'\n'"- $p (read-write, the git directory of the repository the project is a linked worktree of)"
  else context+=$'\n'"- $p (read-write)"; fi
done
for p in "${romounts[@]}"; do context+=$'\n'"- $p (read-only)"; done
wtnote=; [ "$wtothers" -eq 0 ] || wtnote="Other worktrees of this repository aren't mounted, so git worktree list shows them as prunable: they are in use on the host."
if [ -n "$wtro" ]; then
  context+=$'\n'"${wtnote:+$wtnote }The worktrees' records ($wtro) are read-only here, but for those of the worktrees in the pod: git worktree prune, remove and add fail. Don't rename a branch that another worktree has checked out: git renames it, then can't update that worktree's HEAD."
elif [ -n "$wtnote" ]; then
  context+=$'\n'"$wtnote Never run git worktree prune, nor git worktree remove on them."
fi
if [ -n "$binfo" ]; then
  gh_note=$(jq -r .context <<< "$binfo")
elif [ ${#ghsecret[@]} -gt 0 ]; then gh_note="gh and git push over HTTPS use this profile's GitHub token."
else gh_note="This profile has no GitHub token: gh and HTTPS pushes are unauthenticated."; fi
context+=$'\n'"Nothing else from the host is available. There are no permission prompts: the container is the isolation boundary."
context+=$'\n'"$gh_note"
if [ ${#volpaths[@]} -gt 0 ]; then
  context+=$'\n'"Persistent volumes (kept between runs, not on the host filesystem): ${volpaths[*]}."
fi
if [ "$network" = host ]; then
  context+=$'\n'"Network: this pod shares the host's network (including Tailscale and services on the host's localhost)."
fi
if [ -n "$sshkey" ]; then
  context+=$'\n'"SSH: an ssh-agent on the host holds this profile's key (SSH_AUTH_SOCK); the key file itself isn't in the pod. Host aliases are in ~/.ssh/config."
fi
if [ ${#clocal[@]} -gt 0 ]; then
  context+=$'\n'"Local MCP servers enabled for this run: ${clocal[*]} (google-docs-mcp: Google Docs/Sheets/Slides/Drive as the profile's Google account). Servers from a project's .mcp.json that point at host paths won't start here."
fi
if [ ${#ccloud[@]} -gt 0 ]; then
  context+=$'\n'"claude.ai connectors enabled for this run: ${ccloud[*]}. Others are blocked."
else
  context+=$'\n'"claude.ai connectors (Notion, Google Docs, etc.) are disabled for this run; they can be enabled at launch with apod -c."
fi
context+=$'\n'"Work log: keep /run/apod-worklog/worklog.md up to date. It is kept on the host after this pod ends, and the user reviews it, across sessions, for work reports. After each meaningful step, append a few lines under a heading with today's date (## YYYY-MM-DD, a new one when the day changes): what you did, decided or found, what's blocked, what's next. Link PRs, issues and commits; facts, not narration; never secrets. Don't rewrite earlier entries."
if [ "$agent" = claude ]; then cmd+=(--append-system-prompt "$context"); fi

tty=(-i); [ -t 0 ] && tty+=(-t)

# Rewrite GitHub SSH remotes, including github-* host aliases from ~/.ssh/config, to HTTPS
# so pushes authenticate with the profile's token. Both git@host: and bare host: forms.
rewrites=(git@github.com: github.com: ssh://git@github.com/)
if [ -f "$HOME/.ssh/config" ]; then
  while read -r alias; do rewrites+=("git@$alias:" "$alias:" "ssh://git@$alias/"); done < <(
    awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i ~ /^github-/) print $i }' "$HOME/.ssh/config")
fi
gitkv=()   # git config for the pod: key, value, key, value...
for r in "${rewrites[@]}"; do gitkv+=(url.https://github.com/.insteadOf "$r"); done
benv=()
if [ -n "$binfo" ]; then
  # The broker's git config (its remotes' insteadOf, with {forward} filled in by the pod's wrapper,
  # signing) instead of the rewrites to HTTPS above; and its environment.
  gitkv=()
  while IFS=$'\t' read -r k v; do gitkv+=("$k" "$v"); done < <(jq -r '.git_config[] | @tsv' <<< "$binfo")
  while IFS=$'\t' read -r k v; do benv+=(-e "$k=$v"); done < <(jq -r '.env | to_entries[] | [.key, .value] | @tsv' <<< "$binfo")
fi
# The git identity: the profile's [git], else your host's global git config (not the project's
# .git/config, which pods can edit). The committer defaults to the author, and user.name and
# user.email are set to match, over any .gitconfig in the pod's home or the project.
gname=$(pget '.git.name // empty'); gemail=$(pget '.git.email // empty')
cname=$(pget '.git.committer_name // empty'); cemail=$(pget '.git.committer_email // empty')
idenv=()
[ -z "$gname" ] || idenv+=(-e "GIT_AUTHOR_NAME=$gname")
[ -z "$gemail" ] || idenv+=(-e "GIT_AUTHOR_EMAIL=$gemail")
[ -z "$cname" ] || idenv+=(-e "GIT_COMMITTER_NAME=$cname")
[ -z "$cemail" ] || idenv+=(-e "GIT_COMMITTER_EMAIL=$cemail")
[ -n "$gname" ] || gname=$(git config --global --get user.name 2>/dev/null || true)
[ -n "$gemail" ] || gemail=$(git config --global --get user.email 2>/dev/null || true)
if [ -z "$gname" ] || [ -z "$gemail" ]; then
  echo "apod: no git identity for $profile: set user.name and user.email in your ~/.gitconfig, or [git] name and email in $(P .profile.file)" >&2
  exit 2
fi
[ -n "$cname" ] || idenv+=(-e "GIT_COMMITTER_NAME=$gname")
[ -n "$cemail" ] || idenv+=(-e "GIT_COMMITTER_EMAIL=$gemail")
gitkv+=(user.name "$gname" user.email "$gemail")
# git gc prunes worktrees whose folder is missing, and in a pod the repository's other worktrees
# are: never, or it deletes their metadata on the host.
gitkv+=(gc.worktreePruneExpire never)
# With the worktrees' records read-only, git gc's reflog expire fails on the others' reflogs: it
# skips that step when both of these are never. The host's git gc still expires them.
[ -z "$wtro" ] || gitkv+=(gc.reflogExpire never gc.reflogExpireUnreachable never)
# The profile's [pod.env]: -e options, so that a value is what the file says (no env file whose
# quotes podman might keep).
penv=()
while IFS= read -r -d '' kv; do penv+=(-e "$kv"); done < <(plist '.pod.env | to_entries[] | "\(.key)=\(.value)\u0000"')
# [pod] env_from: host variables, passed by name (-e NAME, no value: podman reads the value from its
# own environment, so it isn't in podman's command line). One that isn't set here (in the
# environment, not apod's own shell variables) is left out, with a warning.
while IFS= read -r -d '' k; do
  if printenv "$k" >/dev/null; then penv+=(-e "$k")
  else echo "apod: $k ([pod] env_from) isn't set in your environment: not passed to the pod" >&2; fi
done < <(plist '.pod.env_from[] | "\(.)\u0000"')
gitenv=(-e "GIT_CONFIG_COUNT=$((${#gitkv[@]} / 2))")
for ((i = 0; i < ${#gitkv[@]}; i += 2)); do
  gitenv+=(-e "GIT_CONFIG_KEY_$((i / 2))=${gitkv[i]}" -e "GIT_CONFIG_VALUE_$((i / 2))=${gitkv[i + 1]}")
done

# herdr only sees podman in the pane; tell it which agent's screen to read. Podman doesn't pass
# this into the container.
case $agent in claude|opencode) export HERDR_AGENT=$agent ;; esac

# SELinux for pods with a socket on the host (broker, ssh-key): by default it blocks a container
# from connecting to a host process's socket, so these pods run without labelling, unless
# apod selinux install has loaded the module that allows it (selinux/apod.cil): they then run as
# ordinary containers. Without labelling, relabelling their mounts (:z) does nothing useful, and
# it fails on files you don't own.
selmark=$(P .selinux)
seltype=; [ "$(head -n1 "$selmark" 2>/dev/null)" = apod ] && seltype=apod
if [ -f "$selmark" ] && [ -z "$seltype" ] && { [ -n "$bsid" ] || [ -n "$sshkey" ]; }; then
  echo "apod: the SELinux module is an old version, which breaks these pods: run apod selinux install again (running this pod without labelling)" >&2
fi
if [ -n "$seltype" ]; then sockopts=(); else sockopts=(--security-opt label=disable); fi
if { [ -n "$bsid" ] || [ -n "$sshkey" ]; } && [ -z "$seltype" ]; then
  for i in "${!mounts[@]}"; do
    m=${mounts[$i]}; [ "$m" = -v ] && continue
    m=${m%:z}; m=${m/%,z/}; mounts[i]=$m
  done
fi
run=(podman run --rm "${tty[@]}" --userns=keep-id
  --name "apod-$profile-$(basename "$proj")-$$"
  --hostname "apod-$profile"
  "${ghsecret[@]}"
  "${penv[@]}"
  -e HOME=/home/agent
  -e APOD_PROFILE="$profile"
  -e CLAUDE_CODE_DISABLE_AGENT_VIEW=1
  "${gitenv[@]}" "${idenv[@]}" "${benv[@]}"
  "${mounts[@]}" "${podopts[@]}" -w "$proj")
[ -z "$network" ] || run+=(--network "$network")
run+=("${volumes[@]}" --label apod.profile="$profile" --label apod.project="$proj" --label apod.session="$session")
[ ${#presets[@]} -eq 0 ] || run+=(--label apod.preset="$(IFS=,; echo "${presets[*]}")")

# Remember this launch (apod history, apod resume).
hist=$(P .history); mkdir -p "$(dirname "$hist")"
printf '%s\0' "${recopts[@]}" | jq -cRs --argjson ts "$(date +%s)" --arg profile "$profile" \
  --arg agent "$agent" --arg project "$proj" --arg session "$session" --arg worklog "$worklog" --arg pane "$(pane_id)" \
  '{ts: $ts, profile: $profile, agent: $agent, project: $project,
    session: (if $session == "" then null else $session end), worklog: $worklog, pane: (if $pane == "" then null else $pane end),
    opts: (split("\u0000") | .[:-1])}' \
  >> "$hist" || echo "apod: couldn't record this launch in the history" >&2
if [ -n "$bsid" ]; then
  # Start the git forwarder and put its URL where the broker's git config says {forward}, so
  # GitHub and Radicle remotes go through the broker.
  # shellcheck disable=SC2016 # expanded in the pod
  wrap=$startcmds'u=$(apod-git-forward) || { echo "apod: the git forwarder did not start; git cannot reach the broker" >&2; exec "$@"; }
for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do k=GIT_CONFIG_KEY_$i; v=${!k}; [[ $v == *"{forward}"* ]] && export "$k=${v//"{forward}"/$u}"; done
exec "$@"'
  cmdline=("$image" bash -lc "$wrap" _ "${cmd[@]}" "$@")
  run+=("${sockopts[@]}" --label apod.broker="$bsid")
else
  cmdline=("$image" bash -lc 'gh auth setup-git >/dev/null 2>&1 || true; exec "$@"' _ "${cmd[@]}" "$@")
fi
[ -n "$sshkey" ] || [ -n "$bsid" ] || exec "${run[@]}" "${cmdline[@]}"
if [ -z "$sshkey" ]; then "${run[@]}" "${cmdline[@]}"; exit; fi

# Dedicated ssh-agent for this run: asks for the key's passphrase here, drops the key after
# the key TTL (default 4h), confirms each use if [ssh-agent] confirm is true, and is
# killed when the pod exits. Its socket is in apod's runtime folder (made private here), and the
# pod gets that socket alone (the legacy layout: <profile>/agent/). SELinux: see sockopts above;
# with the module, the agent runs at level s0 so that the pod may connect to it. runcon starts sh,
# which execs ssh-agent: the policy refuses runcon's own exec of ssh-agent (Permission denied),
# and this way the agent is what the broker's is, unconfined_t at s0, which the module lets pods reach.
keyttl=$(python3 "$apoddir/apod-broker" paths --key-ttl) || exit 2
python3 "$apoddir/apod-broker" paths --ensure-runtime || exit 2
adir=$(P .profile.ssh_agent_dir); mkdir -p "$adir"; chmod 700 "$adir"
sock=$(P .profile.ssh_agent_sock)
agentcmd=(ssh-agent); [ -n "$seltype" ] && agentcmd=(runcon -l s0 sh -c 'exec ssh-agent "$@"' ssh-agent)
eval "$("${agentcmd[@]}" -a "$sock")" >/dev/null
agentpid=$SSH_AGENT_PID
