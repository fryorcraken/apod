#!/usr/bin/env python3
"""The pod's side of the broker's gh-api extension: api.github.com resolves to 127.0.0.1 in the
pod, and this relays each connection to it (port 443) to the broker, which ends TLS there. It
starts before the agent, goes to the background once it listens, and only moves bytes: what a
request may do is the broker's business."""
import os
import socket
import sys
import threading

SOCK = os.environ.get("APOD_BROKER_SOCK", "/run/apod-broker/broker.sock")
PORT = int(os.environ.get("APOD_GH_API_PORT", "443"))


def pipe(a, b):
    try:
        while True:
            d = a.recv(65536)
            if not d:
                break
            b.sendall(d)
    except OSError:
        pass
    try:
        b.shutdown(socket.SHUT_WR)
    except OSError:
        pass


def serve(conn):
    up = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        up.connect(SOCK)
        up.sendall(b"POST /gh-api/tunnel HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n")
        buf = b""
        while b"\r\n\r\n" not in buf and len(buf) < 65536:
            d = up.recv(4096)
            if not d:
                return
            buf += d
        head, _, rest = buf.partition(b"\r\n\r\n")
        if not head.startswith(b"HTTP/1.1 200"):
            return  # the broker said why in its log; the client sees the connection close
        if rest:
            conn.sendall(rest)
        t = threading.Thread(target=pipe, args=(up, conn), daemon=True)
        t.start()
        pipe(conn, up)
        t.join(30)
    except OSError:
        pass
    finally:
        up.close()
        conn.close()


def main():
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("127.0.0.1", PORT))
    except OSError as e:
        sys.exit(f"apod-gh-api-relay: can't listen on 127.0.0.1:{PORT} ({e}): api.github.com is unreachable in this pod")
    srv.listen(32)
    if os.fork():
        os._exit(0)
    os.setsid()
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=serve, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    main()
