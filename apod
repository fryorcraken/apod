amount=$(P .profile.ssh_agent_mount); amount+=:$amount; [ -n "$seltype" ] && amount+=:z
"${run[@]}" -v "$amount" -e SSH_AUTH_SOCK="$sock" "${sockopts[@]}" "${cmdline[@]}"
