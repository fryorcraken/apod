# Client side (apod and apod gh ...)

class UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path, timeout=None):
        super().__init__("localhost", timeout=timeout)
        self.sock_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(str(self.sock_path))


def client(path, body, timeout=120):
    c = UnixHTTP(ADMIN, timeout)
    c.request("POST", path, json.dumps(body), {"Content-Type": "application/json"})
    r = c.getresponse()
    out = json.loads(r.read() or b"{}")
    if r.status != 200:
        raise BrokerError(out.get("error", f"broker answered {r.status}"))
    return out


def ensure():
    try:
        client("/state", {}, timeout=5)
        return
    except (OSError, BrokerError, ValueError):
        pass
    BDIR.mkdir(parents=True, exist_ok=True)
    with (BDIR / "broker.log").open("a") as log:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve"], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True, cwd=str(BDIR))
    for _ in range(50):
        time.sleep(0.1)
        try:
            client("/state", {}, timeout=5)
            return
        except (OSError, BrokerError, ValueError):
            pass
    sys.exit(f"apod-broker: didn't start; see {BDIR / 'broker.log'}")


def fmt_time(ts):
    return time.strftime("%m-%d %H:%M:%S", time.localtime(ts))


def print_event(e):
    tg = ", ".join(fmt_target(tuple(t)) for t in e.get("targets", []))
    line = f"{e['id']:>5}  {fmt_time(e['ts'])}  {e['profile']:<14} {e['decision']:<20} {e['request']}"
    if tg:
        line += f"  [{tg}]"
    if e.get("reason") and not e["decision"].startswith("allowed"):
        line += f"\n       {e['reason']}"
    print(line)


def main(argv):
    if not argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    cmd, args = argv[0], argv[1:]
    if cmd == "serve":
        serve()
        return 0
    try:
        if cmd == "register":
            # register --id ID --profile P --persona P [--user U] --project DIR [--scope S]...
            r = {"scope": []}
            it = iter(args)
            for a in it:
                k = a.lstrip("-")
                if k == "scope":
                    r["scope"].append(next(it))
                else:
                    r[k] = next(it)
            ensure()
            print(json.dumps(client("/register", r)))
        elif cmd == "unregister":
            client("/unregister", {"id": args[0]}, timeout=10)
        elif cmd == "ensure":
            ensure()
        elif cmd in ("allow", "deny"):
            if not args:
                sys.exit(f"usage: apod gh {cmd} ID" + (" [--session|--persona]" if cmd == "allow" else ""))
            how = "deny" if cmd == "deny" else "persona" if "--persona" in args else "session" if "--session" in args else "once"
            ev = client("/decide", {"id": int(args[0]), "how": how})
            print(f"apod gh: {'denied' if how == 'deny' else 'allowed (' + how + ')'}: {ev['request']}")
        elif cmd == "pending":
            st = client("/state", {})
            for e in st["pending"]:
                print_event(e)
            if not st["pending"]:
                print("apod gh: nothing waiting for approval", file=sys.stderr)
        elif cmd == "log":
            n = int(args[args.index("-n") + 1]) if "-n" in args else 30
            shown = {}
            first = True
            while True:
                st = client("/state", {})
                evs = st["events"] if not first else st["events"][-n:]
                for e in evs:
                    if shown.get(e["id"]) != e["decision"]:
                        print_event(e)
                        shown[e["id"]] = e["decision"]
                sys.stdout.flush()
                if "-f" not in args:
                    break
                first = False
                time.sleep(1)
        elif cmd == "sessions":
            for s in client("/state", {})["sessions"]:
                scope = s["scope"]["repos"] + [f"owner {o}" for o in s["scope"]["owners"]] + \
                    [f"project {p}" for p in s["scope"]["projects"]]
                print(f"{s['id'][:8]}  {s['profile']:<14} {s['persona']:<11} {s['login']:<16} {s['project']}\n"
                      f"          scope: {', '.join(scope) or '-'}"
                      + (f"\n          granted: {', '.join(s['grants']['actions'] + s['grants']['unscoped'])}"
                         if s["grants"]["actions"] or s["grants"]["unscoped"] else ""))
        elif cmd == "grants":
            if args[:1] == ["rm"]:
                client("/grants/remove", {"persona": args[1], "action": " ".join(args[2:])})
            for p, lst in load_grants()["personas"].items():
                for a in lst:
                    print(f"{p:<12} {a}")
        elif cmd == "personas":
            raw = load_personas()
            for name in raw:
                allow, deny = persona_rules(name, raw)
                print(f"{name}: {raw[name].get('description', '')}\n  allow: {', '.join(allow)}"
                      + (f"\n  deny: {', '.join(deny)}" if deny else ""))
        elif cmd == "ui":
            ensure()
            print(client("/ui", {})["url"])
        elif cmd == "stop":
            client("/stop", {}, timeout=5)
        elif cmd == "restart":
            try:
                client("/stop", {}, timeout=5)
                time.sleep(0.5)
            except (OSError, BrokerError):
                pass
            ensure()
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (OSError, BrokerError) as e:
        if isinstance(e, (FileNotFoundError, ConnectionRefusedError)):
            sys.exit("apod gh: the broker isn't running (it starts with the first pod that uses it)")
        sys.exit(f"apod gh: {e}")
    return 0


UI_HTML = """<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
