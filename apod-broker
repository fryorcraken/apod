const tgt=t=>({repo:t[1],owner:'owner '+t[1],project:'project '+t[1],'projects-of':'projects of '+t[1],forkdest:'fork into '+t[1],unscoped:'unscoped: '+t[1]}[t[0]]||t.join(' '));
const tm=ts=>new Date(ts*1000).toLocaleTimeString();
async function post(p,b){const r=await fetch(p,{method:'POST',headers:{'X-Apod-Token':T,'Content-Type':'application/json'},body:JSON.stringify(b)});if(!r.ok){alert((await r.json()).error)}load()}
