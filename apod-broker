# Servers

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def address_string(self):
        return "local"

    def log_message(self, fmt, *args):
        pass

    def send_json(self, obj, status=200):
        data = (json.dumps(obj) + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(data)
        self.close_connection = True


class SessionHandler(Handler):
    def sess(self):
        return SESSIONS.get(self.server.session_id)

    def do_GET(self):
        self.close_connection = True
        sess = self.sess()
        if not sess:
            return self.send_json({"error": "session closed"}, 410)
        if self.path == "/whoami":
            return self.send_json(sess.summary())
        if self.path.startswith("/git/"):
            return self.guard(handle_git, sess, "GET")
        self.send_json({"error": "not found"}, 404)

    def do_POST(self):
        self.close_connection = True
        sess = self.sess()
        if not sess:
            return self.send_json({"error": "session closed"}, 410)
        if self.path == "/gh":
            return self.guard(handle_gh, sess, read_body(self))
        if self.path.startswith("/git/"):
            return self.guard(handle_git, sess, "POST")
        self.send_json({"error": "not found"}, 404)

    def guard(self, fn, *args):
        try:
            fn(self, *args)
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as e:  # keep the broker up; tell the client if we still can
            print(f"apod-broker: {fn.__name__}: {e!r}", file=sys.stderr)
            try:
                git_deny(self, f"internal error: {e}", 500)
            except OSError:
                pass


class UnixServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def listen_session(sess):
    sess.dir.mkdir(parents=True, exist_ok=True)
    sock = sess.dir / "gh.sock"
    if len(os.fsencode(sock)) > 107:
        raise BrokerError(f"socket path too long for a unix socket: {sock} (use a shorter APOD_ROOT)")
    if sock.exists():
        sock.unlink()
    srv = UnixServer(str(sock), SessionHandler)
    srv.session_id = sess.id
    os.chmod(sock, 0o600)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    SERVERS[sess.id] = srv


def register(r):
    sid = r.get("id") or secrets.token_hex(6)
    if not re.fullmatch(r"[A-Za-z0-9_-]{4,64}", sid):
        raise BrokerError("bad session id")
    persona = r.get("persona") or ""
    persona_rules(persona)  # fails on an unknown persona
    user = r.get("user") or ""
    tok = token_for(user)
    login = user
    if not login:
        try:
            out = subprocess.run([gh_bin(), "api", "user", "--jq", ".login"], capture_output=True, text=True,
                                 env=gh_env(tok), cwd=BDIR / "home", timeout=30, stdin=subprocess.DEVNULL)
            login = out.stdout.strip()
        except subprocess.TimeoutExpired:
            pass
    scope = {"repos": [], "owners": [], "projects": []}
    for s in r.get("scope", []):
        s = s.strip().lower()
        if not s:
            continue
        if s.startswith("project:"):
            scope["projects"].append(s[8:])
        elif "/" in s:
            scope["repos"].append(norm_repo(s) if "*" not in s else s)
        else:
            scope["owners"].append(s)
    sess = Session({"id": sid, "profile": r.get("profile", ""), "persona": persona, "user": user,
                    "login": login, "project": r.get("project", ""), "scope": scope,
                    "grants": {}, "created": now()})
    with LOCK:
        if sid in SESSIONS:
            unregister(sid)
        SESSIONS[sid] = sess
        listen_session(sess)
        sess.save()
    return {"id": sid, "dir": str(sess.dir), "ask_timeout": ASK_TIMEOUT, **sess.summary()}


def unregister(sid):
    with LOCK:
        SESSIONS.pop(sid, None)
        srv = SERVERS.pop(sid, None)
        if srv:
            srv.shutdown()
            srv.server_close()
        shutil.rmtree(SDIR / sid, ignore_errors=True)


def state():
    with LOCK:
        return {"sessions": [s.data() for s in SESSIONS.values()],
                "pending": [p.ev for p in PENDING.values()],
                "events": list(EVENTS)[-200:],
                "grants": load_grants()["personas"],
                "ask_timeout": ASK_TIMEOUT}


def admin_call(path, body):
    if path == "/register":
        return register(body)
    if path == "/unregister":
        unregister(body["id"])
        return {"ok": True}
    if path == "/decide":
        return decide(int(body["id"]), body["how"])
    if path == "/grants/remove":
        g = load_grants()
        lst = g["personas"].get(body["persona"], [])
        if body["action"] in lst:
            lst.remove(body["action"])
        save_grants(g)
        return {"ok": True}
    if path == "/scope/remove":
        sess = SESSIONS[body["session"]]
        for k in ("repos", "owners", "projects"):
            if body["value"] in sess.scope[k]:
                sess.scope[k].remove(body["value"])
        for k in ("actions", "unscoped"):
            if body["value"] in sess.grants[k]:
                sess.grants[k].remove(body["value"])
        sess.save()
        return {"ok": True}
    if path == "/state":
        return state()
    if path == "/ui":
        return {"url": UI.get("url")}
    if path == "/stop":
        threading.Thread(target=lambda: (time.sleep(0.2), os._exit(0)), daemon=True).start()
        return {"ok": True}
    raise BrokerError(f"unknown admin call {path}")


class AdminHandler(Handler):
    def do_POST(self):
        self.close_connection = True
        try:
            body = json.loads(read_body(self) or b"{}")
            self.send_json(admin_call(self.path, body))
        except (BrokerError, KeyError, ValueError) as e:
            self.send_json({"error": str(e)}, 400)


class UIHandler(Handler):
    def authed(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        tok = self.headers.get("X-Apod-Token") or q.get("t", [""])[0]
        return secrets.compare_digest(tok, UI["token"])

    def do_GET(self):
        self.close_connection = True
        if not self.authed():
            return self.send_json({"error": "forbidden"}, 403)
        if urllib.parse.urlparse(self.path).path == "/api/state":
            return self.send_json(state())
        data = UI_HTML.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        self.close_connection = True
        if not self.authed() or self.headers.get("Origin") not in (None, UI["origin"]):
            return self.send_json({"error": "forbidden"}, 403)
        path = urllib.parse.urlparse(self.path).path
        if path not in ("/api/decide", "/api/grants/remove", "/api/scope/remove"):
            return self.send_json({"error": "not found"}, 404)
        try:
            body = json.loads(read_body(self) or b"{}")
            self.send_json(admin_call(path[4:], body))
        except (BrokerError, KeyError, ValueError) as e:
            self.send_json({"error": str(e)}, 400)


class TCPServer(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


def serve():
    for d in (BDIR, SDIR, BDIR / "home" / "gh", BDIR / "tmp"):
        d.mkdir(parents=True, exist_ok=True)
    os.chmod(BDIR, 0o700)
    shutil.rmtree(BDIR / "tmp", ignore_errors=True)
    (BDIR / "tmp").mkdir()
    global COUNTER
    last = 0
    try:
        with LOGF.open() as f:
            for line in f:
                try:
                    last = max(last, json.loads(line).get("id", 0))
                except ValueError:
                    pass
    except OSError:
        pass
    COUNTER = itertools.count(last + 1)
    if ADMIN.exists():
        try:
            client("/state", {})
            sys.exit("apod-broker: already running")
        except (OSError, BrokerError):
            ADMIN.unlink()
    for d in SDIR.iterdir():
        try:
            sess = Session(json.loads((d / "session.json").read_text()))
        except (OSError, ValueError):
            shutil.rmtree(d, ignore_errors=True)
            continue
        try:
            listen_session(sess)
            SESSIONS[sess.id] = sess
        except (OSError, BrokerError) as e:
            print(f"apod-broker: dropping session {sess.id}: {e}", file=sys.stderr)
            shutil.rmtree(d, ignore_errors=True)
    ui = TCPServer(("127.0.0.1", UI_PORT), UIHandler)
    UI["token"] = secrets.token_urlsafe(24)
    UI["origin"] = f"http://127.0.0.1:{ui.server_address[1]}"
    UI["url"] = f"{UI['origin']}/?t={UI['token']}"
    UIF.write_text(json.dumps({"url": UI["url"]}) + "\n")
    os.chmod(UIF, 0o600)
    threading.Thread(target=ui.serve_forever, daemon=True).start()
    admin = UnixServer(str(ADMIN), AdminHandler)
    os.chmod(ADMIN, 0o600)
    print(f"apod-broker: up ({len(SESSIONS)} sessions), ui {UI['origin']}", file=sys.stderr, flush=True)
    admin.serve_forever()


