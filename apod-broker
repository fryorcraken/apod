# git over HTTP: the pod's github.com remotes come here (through the pod's apod-git-forward)

def pkt(data):
    return b"%04x" % (len(data) + 4) + data


def sideband(band, data):
    out = b""
    for i in range(0, len(data), 65000):
        out += pkt(bytes([band]) + data[i:i + 65000])
    return out


def read_body(h):
    if h.headers.get("Transfer-Encoding", "").lower() == "chunked":
        chunks = []
        while True:
            n = int(h.rfile.readline().split(b";")[0].strip() or b"0", 16)
            if n == 0:
                while h.rfile.readline() not in (b"\r\n", b"\n", b""):
                    pass
                break
            chunks.append(h.rfile.read(n))
            h.rfile.readline()
        return b"".join(chunks)
    return h.rfile.read(int(h.headers.get("Content-Length") or 0))


def push_commands(body, gzipped):
    """Ref updates and capabilities at the start of a receive-pack request."""
    data = body[:1 << 20]
    if gzipped:
        data = zlib.decompressobj(16 + zlib.MAX_WBITS).decompress(body, 1 << 20)
    cmds, caps, i = [], set(), 0
    while i + 4 <= len(data):
        n = int(data[i:i + 4], 16)
        if n == 0:
            break
        line = data[i + 4:i + n].rstrip(b"\n")
        i += n
        if line.startswith(b"shallow "):
            continue
        if b"\0" in line:
            line, c = line.split(b"\0", 1)
            caps |= set(c.decode().split())
        parts = line.decode().split(" ")
        if len(parts) != 3:
            raise BrokerError(f"unexpected push command: {line[:80]!r}")
        cmds.append(parts)
    return cmds, caps


_repo_info = {}


def repo_info(sess, repo):
    if repo not in _repo_info:
        out = gh_query(sess, ["api", f"repos/{repo}", "--jq", "{default_branch, private}"])
        try:
            _repo_info[repo] = json.loads(out or "")
        except ValueError:
            return {}
    return _repo_info[repo]


def upstream_request(sess, method, path, body, h, gzip_ok=True):
    u = urllib.parse.urlparse(UPSTREAM)
    conn = (http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection)(
        u.hostname, u.port, timeout=600)
    names = ("Content-Type", "Accept", "Content-Encoding", "Git-Protocol", "User-Agent") + \
        (("Accept-Encoding",) if gzip_ok else ())
    headers = {k: h.headers[k] for k in names if h.headers.get(k)}
    tok = token_for(sess.user)
    headers["Authorization"] = "Basic " + base64.b64encode(f"x-access-token:{tok}".encode()).decode()
    conn.request(method, path, body=body, headers=headers)
    return conn, conn.getresponse()


def relay_response(h, resp, started=False):
    if not started:
        h.send_response(resp.status)
        for k, v in resp.getheaders():
            if k.lower() not in ("connection", "transfer-encoding", "keep-alive"):
                h.send_header(k, v)
        h.send_header("Connection", "close")
        h.end_headers()
    for chunk in iter(lambda: resp.read(65536), b""):
        h.wfile.write(chunk)
    h.wfile.flush()


def git_deny(h, text, status=403):
    data = f"apod gh broker: {text}\n".encode()
    h.send_response(status)
    h.send_header("Content-Type", "text/plain; charset=utf-8")
    h.send_header("Content-Length", str(len(data)))
    h.send_header("Connection", "close")
    h.end_headers()
    h.wfile.write(data)


def handle_git(h, sess, method):
    u = urllib.parse.urlparse(h.path)
    m = re.match(r"^/git/([^/]+)/([^/]+?)(?:\.git)?/(info/refs|git-upload-pack|git-receive-pack)$", u.path)
    if not m:
        return git_deny(h, f"not a git request the broker handles: {u.path}", 404)
    repo = f"{m.group(1)}/{m.group(2)}".lower()
    endpoint = m.group(3)
    service = urllib.parse.parse_qs(u.query).get("service", [""])[0] if endpoint == "info/refs" else endpoint
    if service not in ("git-upload-pack", "git-receive-pack") or (endpoint == "info/refs") != (method == "GET"):
        return git_deny(h, "unsupported git request", 400)
    body = read_body(h) if method == "POST" else None
    upath = f"/{m.group(1)}/{m.group(2)}.git/{endpoint}" + (f"?{u.query}" if u.query else "")
    push = service == "git-receive-pack"
    req = Request("git", f"git {'push' if push else 'fetch'} {repo}")
    req.targets = [("repo", repo)]

    def forward():
        conn, resp = upstream_request(sess, method, upath, body, h, gzip_ok=not push)
        relay_response(h, resp)

    if not push:
        req.actions = ["git fetch"]
        if not sess.in_scope(("repo", repo)) and repo_info(sess, repo).get("private") is False:
            req.actions, req.targets = ["git fetch public"], []
        if method == "POST":
            # Checked (and logged) at the ref advertisement; the negotiation rounds follow it.
            if evaluate(sess, req)[0] != "allow" and not any(
                    e["session"] == sess.id and e["request"] == req.display and now() - e["ts"] < 600
                    and e["decision"].startswith(("allowed", "approved")) for e in list(EVENTS)):
                return git_deny(h, f"fetch of {repo} not allowed")
            return forward()
    elif method == "GET":
        # The ref advertisement before a push: only the repository's scope matters here; the ref
        # updates themselves are checked when they come (POST).
        if sess.in_scope(("repo", repo)):
            return forward()
        req.display += " (before a push)"
    else:
        return handle_push(h, sess, req, repo, upath, body)
    ev = new_event(sess, req)
    ev["push_adv"] = push
    ok = authorize(sess, req, ev)
    log_event(ev)
    if not ok:
        return git_deny(h, f"{req.display} rejected ({ev['decision']}): {ev['reason']}. "
                           f"The user can allow it (apod gh allow {ev['id']} --session) and you can retry.")
    forward()


def handle_push(h, sess, req, repo, upath, body):
    try:
        cmds, caps = push_commands(body, h.headers.get("Content-Encoding", "").lower() == "gzip")
    except (BrokerError, ValueError, zlib.error) as e:
        return git_deny(h, f"couldn't read the push: {e}")
    default = repo_info(sess, repo).get("default_branch")
    kinds = []
    for old, new, ref in cmds:
        if set(new) == {"0"}:
            kinds.append("git push delete")
        elif ref.startswith("refs/tags/"):
            kinds.append("git push tag")
        elif ref == f"refs/heads/{default}" or (default is None and ref in ("refs/heads/main", "refs/heads/master")):
            kinds.append("git push default-branch")
        elif ref.startswith("refs/heads/"):
            kinds.append("git push branch")
        else:
            kinds.append("git push other-ref")
    req.actions = list(dict.fromkeys(kinds)) or ["git push"]
    req.display = f"git push {repo} " + " ".join(ref for _, _, ref in cmds)
    band = "side-band-64k" in caps or "side-band" in caps
    started = False

    def start():
        nonlocal started
        if not started:
            h.send_response(200)
            h.send_header("Content-Type", "application/x-git-receive-pack-result")
            h.send_header("Cache-Control", "no-cache")
            h.send_header("Connection", "close")
            h.end_headers()
            started = True

    def waiting(ev):
        # With side-band, git shows these as "remote: ..." lines while the push waits.
        if band:
            start()
            h.wfile.write(sideband(2, f"apod gh broker: this push needs your approval ({ev['reason']}). "
                                      f"Waiting up to {ASK_TIMEOUT:.0f}s. On the host: apod gh allow {ev['id']} "
                                      f"[--session|--persona], or apod gh ui\n".encode()))
            h.wfile.flush()

    ev = new_event(sess, req)
    ok = authorize(sess, req, ev, waiting)
    log_event(ev)
    if not ok:
        msg = f"push rejected ({ev['decision']}): {ev['reason']}"
        if not band and not started:
            return git_deny(h, msg)
        start()
        report = pkt(b"unpack ok\n") + b"".join(pkt(f"ng {ref} {msg}\n".encode()) for _, _, ref in cmds) + b"0000"
        h.wfile.write(sideband(2, f"apod gh broker: {msg}\n".encode()) + sideband(1, report) + b"0000")
        return
    conn, resp = upstream_request(sess, "POST", upath, body, h, gzip_ok=False)
    if started and resp.status != 200:
        h.wfile.write(sideband(3, f"GitHub answered {resp.status} {resp.reason}\n".encode()))
        return
    relay_response(h, resp, started)


