#!/usr/bin/env python3
"""apod broker: acts on the host for apod pods (gh, GitHub and Radicle remotes, commit signing,
ssh), so that pods hold no credentials. See broker/core.py, and `apod broker` for approvals."""
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / "broker"))

import core  # noqa: E402
import gh, github, rad, sign, ssh  # noqa: E402,F401  (providers register themselves, in this order)

if __name__ == "__main__":
    sys.exit(core.main(sys.argv[1:], Path(__file__).resolve()))
