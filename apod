#!/usr/bin/env bash
# apod <profile> [-a claude|opencode|bash] [-p PRESET]... [-i IMAGE] [-c CONNECTORS] [--ro PATH]... [--rw PATH]... [--role R] [--scope S]... [--gh-user ACCOUNT] [--no-broker] [project-dir] [-- agent args...]
# Run a coding agent in a podman container as a given GitHub identity.
# Per profile: a persistent $HOME and a profile.toml (where: broker/paths.py, through apod-broker
# paths): git identity, extra mounts, image, environment... and either the broker (no credentials
# in the pod, the host's apod broker acts for it: gh, GitHub and Radicle remotes, commit signing,
# ssh) or the podman secret gh-<profile> (GitHub token). In the legacy layout (~/.agent-pod),
# profiles in the old files are read as before (apod migrate converts them). apod-broker profile
# reads them all: see broker/profiles.py. A preset (-p, presets/NAME.toml in the config folder) is
# a kind of job any profile can launch with: pod settings (image, mounts, network, volumes,
# environment), and a role and scope for the broker, as --role and --scope give.
set -euo pipefail

usage() {
  echo "usage: apod <profile> [-a claude|opencode|bash] [-p PRESET]... [-i IMAGE] [-c CONNECTORS] [--ro PATH]... [--rw PATH]... [--role R] [--scope S]... [--gh-user ACCOUNT] [--no-broker] [project-dir] [-- agent args...]" >&2
  echo "       apod new [profile] | migrate [profile|--all] | migrate --layout [profile] | resume [--list|--latest|--claude] [launch options] [dir] | history | ps | profiles | presets | token <profile> [--rm] | google-auth <profile>" >&2
  echo "       apod broker [ui]|log [-f] [-n N]|pending|allow ID [--session|--role]|deny ID|sessions|roles|grants|scopes|keys|restart|stop" >&2
  echo "       apod selinux [install|remove|status]" >&2
  exit 2
}

# claude.ai connector groups for -c, and the connector servers each one enables.
declare -A connector_servers=(
  [notion]="Notion"
  [gdoc]="Google_Docs Google_Drive Google_Sheets"
  [todoist]="Todoist"
  [canva]="Canva"
  [lovable]="Lovable"
  [utsjitsu]="UTS_Jitsu"
  [claudedocs]="Claude_Docs"
)
# Local MCP servers for -c, run in the pod from a read-only mount of their checkout.
# google-docs-mcp: OAuth client from the profile's google-credentials.json if present (mounted over
# the checkout's credentials.json in the pod), else the checkout's; Google login per profile
# (apod google-auth <profile>), limited to these scopes for both sign-in and use.
local_mcps=(google-docs-mcp)
gdocs_mcp=${APOD_GDOCS_MCP:-$HOME/src/fryorcraken/google-docs-mcp}
gdocs_scopes=${APOD_GDOCS_SCOPES:-docs,sheets,slides,drive}
# Identity of the terminal tab, recorded with each launch so apod resume can go straight to the
# session a tab started: the first set variable among $APOD_PANE_ENV (default: herdr's pane id,
# then HC_SCOPE), as "NAME:value". Empty when none is set; resume then always lists.
pane_id() {
  local v
  for v in ${APOD_PANE_ENV:-HERDR_PANE_ID HC_SCOPE}; do
    if [ -n "${!v:-}" ]; then echo "$v:${!v}"; return; fi
  done
}
# This checkout: the broker (apod-broker, broker/) lives next to apod.
apoddir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
# apod reads profiles with Python's tomllib: Python 3.11 or newer.
need_python() {
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null || {
    echo "apod: Python 3.11 or newer is required to read profiles (python3 here: $(python3 --version 2>&1 || echo missing))" >&2
    exit 2
  }
}
# Where apod's files are (broker/paths.py: the new layout, or the legacy ~/.agent-pod), as JSON:
# load_paths [--profile NAME [--pid PID]] sets $paths, P runs a jq filter on it. The first call
# in a run says when the legacy layout is in use.
paths=
load_paths() {
  local n
  need_python
  paths=$(python3 "$apoddir/apod-broker" paths --json "$@") || exit 2
  n=$(jq -r '.notice // empty' <<< "$paths")
  if [ -n "$n" ] && [ -z "${APOD_NOTICE_SHOWN:-}" ]; then echo "apod: $n" >&2; export APOD_NOTICE_SHOWN=1; fi
}
P() { jq -r "$@" <<< "$paths"; }
# For shell completion.
if [ "${1:-}" = --list-roles ]; then python3 "$apoddir/apod-broker" roles --plain 2>/dev/null | cut -f1; exit 0; fi
if [ "${1:-}" = --list-profiles ]; then python3 "$apoddir/apod-broker" paths --json 2>/dev/null | jq -r '.all_profiles | keys[]'; exit 0; fi
if [ "${1:-}" = --list-presets ]; then python3 "$apoddir/apod-broker" paths --json 2>/dev/null | jq -r '.all_presets | keys[]'; exit 0; fi
if [ "${1:-}" = --list-connectors ]; then printf '%s\n' "${!connector_servers[@]}" "${local_mcps[@]}" | sort; exit 0; fi

# Subcommands: manage a profile's GitHub token (podman secret gh-<profile>) and Google login,
# list profiles.
case ${1:-} in
  broker|gh)
    # The broker: approvals, log, sessions, keys (see apod-broker).
    shift; [ $# -ge 1 ] || set -- ui
    exec python3 "$apoddir/apod-broker" "$@" ;;
  selinux)
    # Let pods that use a socket on the host (broker, ssh-key) keep SELinux labelling: load
    # selinux/apod.cil, which lets containers connect to those sockets, or remove it. Without it,
    # those pods run with labelling off.
    load_paths; mark=$(P .selinux)
    case ${2:-status} in
      install)
        if ! { command -v selinuxenabled >/dev/null && selinuxenabled; }; then
          echo "apod: SELinux isn't enabled on this host: nothing to do" >&2; exit 1
        fi
        echo "apod: loading the apod SELinux module: sudo semodule -i $apoddir/selinux/apod.cil" >&2
        sudo semodule -i "$apoddir/selinux/apod.cil" || exit 1
        sudo semodule -r apod_container >/dev/null 2>&1 || true  # the first version's module
        mkdir -p "$(dirname "$mark")"; echo apod > "$mark"
        echo "apod: pods with a host socket now keep SELinux labelling (as container_t)."
        echo "apod: restart the broker so it runs at level s0: apod broker restart" ;;
      remove)
        sudo semodule -r apod || true
        sudo semodule -r apod_container >/dev/null 2>&1 || true
        rm -f "$mark"
        echo "apod: removed: pods with a host socket run without SELinux labelling again. Then: apod broker restart" ;;
      status)
        if [ "$(head -n1 "$mark" 2>/dev/null)" = apod ]; then echo "apod: pods with a host socket keep SELinux labelling (module apod)"
        elif [ -f "$mark" ]; then echo "apod: an old version of the module is installed: apod selinux install replaces it"
        else echo "apod: pods with a host socket run without SELinux labelling (apod selinux install changes that)"; fi
        if command -v getenforce >/dev/null; then echo "SELinux: $(getenforce)"; fi ;;
      *) echo "usage: apod selinux [install|remove|status]" >&2; exit 2 ;;
    esac
    exit ;;
  migrate)
    # Old profile files (env, mounts, broker.toml...) to one profile.toml; the old files move to .old/.
    # --layout: the legacy layout (~/.agent-pod) to the new one (broker/migrate_layout.py).
    need_python
    shift; exec python3 "$apoddir/apod-broker" migrate "$@" ;;
  google-auth)
    [ $# -ge 2 ] || { echo "usage: apod google-auth <profile>" >&2; exit 2; }
    load_paths --profile "$2"
    [ "$(P .profile.exists)" = true ] || { echo "apod: no profile $2" >&2; exit 2; }
    phome=$(P .profile.home); gcred=$(P .profile.google_credentials)
    mkdir -p "$phome/.config"
    client=()
    if [ -f "$gcred" ]; then
      client=(GOOGLE_CLIENT_ID="$(jq -r '(.installed // .web).client_id' "$gcred")"
              GOOGLE_CLIENT_SECRET="$(jq -r '(.installed // .web).client_secret' "$gcred")")
    fi
    echo "apod: Google sign-in for profile $2 (scopes: $gdocs_scopes), saved under $phome/.config/google-docs-mcp/" >&2
    exec env -u GOOGLE_CLIENT_ID -u GOOGLE_CLIENT_SECRET -u GOOGLE_MCP_PROFILE "${client[@]}" \
      XDG_CONFIG_HOME="$phome/.config" GOOGLE_MCP_SCOPES="$gdocs_scopes" \
      node "$gdocs_mcp/dist/index.js" auth ;;
  token)
    [ $# -ge 2 ] || { echo "usage: apod token <profile> [--rm]" >&2; exit 2; }
    if [ "${3:-}" = --rm ]; then
      podman secret rm "gh-$2" >/dev/null && echo "apod: removed token for $2"
      exit
    fi
    read -rsp "GitHub token for $2: " tok; echo >&2
    [ -n "$tok" ] || { echo "apod: empty token, nothing stored" >&2; exit 2; }
    printf %s "$tok" | podman secret create --replace "gh-$2" - >/dev/null
    login=$(GH_TOKEN=$tok gh api user --jq .login 2>/dev/null) || login="unknown (gh api user failed)"
    unset tok
    echo "apod: stored token for $2 (podman secret gh-$2), GitHub account: $login"
    echo "apod: the broker is recommended instead of tokens: no credentials in the pod, and you approve what's out of scope (see README, Broker)" >&2
    exit ;;
  history)
    # Folders and profiles launched, most recent first (from history.jsonl, one line per launch).
    load_paths; hist=$(P .history)
    [ -f "$hist" ] || { echo "apod: no launches recorded yet" >&2; exit 0; }
    jq -rs 'group_by([.project, .profile]) | map(max_by(.ts) + {n: length}) | sort_by(.ts) | reverse | .[]
      | [(.ts | strflocaltime("%Y-%m-%d %H:%M")), .profile, "\(.n)x", .project] | @tsv' "$hist" | column -t -s $'\t'
    exit ;;
  ps)
    # The profile column says the presets too, as the launch did: "work -p logos".
    podman ps --filter label=apod.profile --format json | jq -r '.[] | [.Labels["apod.profile"]
        + (.Labels["apod.preset"] // "" | if . == "" then "" else " -p \(.)" end),
      (.Labels["apod.session"] // "" | .[:8]), .Status, .Labels["apod.project"]] | @tsv' | column -t -s $'\t'
    exit ;;
  presets)
    # Each preset (presets/NAME.toml in the config folder): what it sets, and its description.
    need_python
    shift; exec python3 "$apoddir/apod-broker" presets "$@" ;;
  resume)
    # Resume a stopped Claude session started in a folder (one launched by apod, with a saved
    # conversation), with the same profile and options. In a herdr pane that launched one of them,
    # resume that one; otherwise list them and ask. --list always asks, --latest takes the newest,
    # --claude opens Claude's own picker for the latest launch's profile. Launch options (all but
    # -a: it's Claude's session) go after the recorded ones (see merge). The relaunch records them,
    # so the next resume keeps them.
    shift; mode=ask; dir=; more=()
    rusage() { echo "usage: apod resume [--list|--latest|--claude] [launch options] [dir]" >&2; exit 2; }
    while [ $# -gt 0 ]; do
      case $1 in
        --list) mode=list ;; --latest) mode=latest ;; --claude) mode=claude ;;
        -p|--preset|-i|--image|-c|--connectors|-m|--ro|--rw|--role|--persona|--gh-user|--scope)
          [ $# -ge 2 ] || rusage; more+=("$1" "$2"); shift ;;
        --no-broker) more+=("$1") ;;
        -a) echo "apod: resume relaunches a Claude session: -a doesn't apply" >&2; exit 2 ;;
        -*) rusage ;;
        *) [ -z "$dir" ] || rusage; dir=$1 ;;
      esac
      shift
    done
    # The relaunch's options, in ropts: the recorded ones (opts), then the given ones (more), as if typed
    # after them: --scope, --ro, --rw, -p and -c add, --role, -i and --gh-user replace. Recorded ones
    # that a given one makes pointless are left out, so that the history doesn't grow with each
    # resume: the same --scope, a mount of the same path (the given mode wins), the --role, -i or
    # --gh-user replaced. --no-broker given leaves out the recorded --role, --scope and --gh-user,
    # and one of those given leaves out a recorded --no-broker. -c adds to the session's
    # connectors: if it was launched without -c, to the profile's [pod] connectors, which a -c
    # alone would replace.
    merge() {
      local i o v nobroker='' broker='' conn='' hadc=''
      local -A rgiven=() rscope=() rpath=()
      for ((i = 0; i < ${#more[@]}; i++)); do
        o=${more[i]}
        if [ "$o" = --no-broker ]; then nobroker=1; continue; fi
        v=${more[++i]}
        case $o in
          --role|--persona) rgiven[--role]=1; broker=1 ;;
          --gh-user) rgiven[--gh-user]=1; broker=1 ;;
          --scope) rscope[$v]=1; broker=1 ;;
          -i|--image) rgiven[-i]=1 ;;
          -m|--ro|--rw) rpath[$(realpath -m "$v")]=1 ;;
          -c|--connectors) conn=1 ;;
        esac
      done
      ropts=("${opts[0]}")
      for ((i = 1; i < ${#opts[@]}; i++)); do
        o=${opts[i]}
        if [ "$o" = --no-broker ]; then [ -n "$broker" ] || ropts+=("$o"); continue; fi
        v=${opts[++i]}
        case $o in
          --role|--persona) [ -z "$nobroker${rgiven[--role]:-}" ] || continue ;;
          --gh-user) [ -z "$nobroker${rgiven[--gh-user]:-}" ] || continue ;;
          --scope) [ -z "$nobroker${rscope[$v]:-}" ] || continue ;;
          -i|--image) [ -z "${rgiven[-i]:-}" ] || continue ;;
          -m|--ro|--rw) [ -z "${rpath[$v]:-}" ] || continue ;;
          -c|--connectors) hadc=1 ;;
        esac
        ropts+=("$o" "$v")
      done
      if [ -n "$conn" ] && [ -z "$hadc" ]; then
        v=$(python3 "$apoddir/apod-broker" profile --profile "${opts[0]}" --quiet < /dev/null 2>/dev/null \
          | jq -r '.pod.connectors | join(",")') || v=
        [ -z "$v" ] || ropts+=(-c "$v")
      fi
      ropts+=("${more[@]}")
    }
    here_pane=$(pane_id)
    dir=$(realpath "${dir:-$PWD}")
    load_paths; hist=$(P .history)
    [ -f "$hist" ] || { echo "apod: no launches recorded yet" >&2; exit 2; }
    running=$(podman ps --filter label=apod.session --format json | jq -r '.[].Labels["apod.session"] // empty')
    sids=(); lines=(); labels=(); panes=(); declare -A seen=() homes=()
    while IFS=$'\t' read -r p h; do homes[$p]=$h; done < <(P '.all_profiles | to_entries[] | [.key, .value.home] | @tsv')
    while IFS= read -r line; do
      mapfile -t opts < <(jq -r '.opts[]' <<< "$line")
      if [ "$mode" = claude ]; then merge; exec "$0" "${ropts[@]}" "$dir" -- --resume; fi
      sid=$(jq -r '.session // empty' <<< "$line")
      [ -n "$sid" ] && [ -z "${seen[$sid]+x}" ] || continue
      seen[$sid]=1
      grep -qx "$sid" <<< "$running" && continue
      home=; [ -z "${opts[0]:-}" ] || home=${homes[${opts[0]}]:-}
      tr=; [ -z "$home" ] || tr=$(compgen -G "$home/.claude/projects/*/$sid.jsonl" | head -n1 || true)
      [ -n "$tr" ] || continue
      # Label: the /rename title if any, else the first prompt. (|| true: none, a line jq can't
      # read, or grep -m1 done before the rest is written fails the pipeline, which would end apod.)
      title=$(jq -r 'select(.type == "custom-title") | .customTitle' "$tr" 2>/dev/null | tail -n1) || true
      [ -n "$title" ] || title=$(head -n 400 "$tr" | jq -r 'select(.type == "user" and (.isMeta | not))
        | .message.content | if type == "string" then . else (map(select(.type == "text").text) | join(" ")) end' 2>/dev/null \
        | grep -v '^<' | grep -m1 .) || true
      sids+=("$sid"); lines+=("$line"); panes+=("$(jq -r '.pane // empty' <<< "$line")")
      labels+=("$(date -r "$tr" '+%m-%d %H:%M')  ${opts[0]}  ${title:0:70}")
    done < <(jq -c --arg d "$dir" 'select(.project == $d and .agent == "claude")' "$hist" | tac)
    [ ${#sids[@]} -gt 0 ] || { echo "apod: nothing to resume in $dir (no stopped Claude session there with a saved conversation)" >&2; exit 2; }
    n=
    if [ "$mode" = latest ]; then n=1
    elif [ "$mode" = ask ] && [ -n "$here_pane" ]; then
      for i in "${!panes[@]}"; do
        if [ "${panes[$i]}" = "$here_pane" ]; then n=$((i + 1)); echo "apod: this tab ($here_pane) launched it (apod resume --list to choose another)" >&2; break; fi
      done
    fi
    if [ -z "$n" ]; then
      for i in "${!labels[@]}"; do printf '%2d) %s\n' "$((i + 1))" "${labels[$i]}" >&2; done
      read -rp "Resume which? [1] " n < /dev/tty; n=${n:-1}
      # No leading 0: bash reads 08 as octal, and $((n - 1)) would fail.
      [[ $n =~ ^[1-9][0-9]*$ ]] && [ "$n" -le ${#sids[@]} ] || { echo "apod: no such choice" >&2; exit 2; }
    fi
    mapfile -t opts < <(jq -r '.opts[]' <<< "${lines[$((n - 1))]}")
    shown=; [ ${#more[@]} -eq 0 ] || printf -v shown ' %q' "${more[@]}"
    echo "apod: resuming ${labels[$((n - 1))]}${shown:+, adding$shown}" >&2
    merge; exec "$0" "${ropts[@]}" "$dir" -- --resume "${sids[$((n - 1))]}" ;;
  new)
    # A wizard for a new profile: the GitHub account, git identity, signing, ssh, Radicle,
    # notifications, role, scope, mounts and image. It shows the profile.toml it would write, and
    # writes nothing until you say yes.
    need_python
    cb=; cdim=; cy=; cr=
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then cb=$'\e[1m'; cdim=$'\e[2m'; cy=$'\e[1;33m'; cr=$'\e[0m'; fi
    ask() {  # ask VAR QUESTION [DEFAULT]: a line from stdin, DEFAULT when empty
      local a ok=0
      if [ -t 0 ]; then
        # readline: line editing and Tab completion of paths. Colours go between \001 and \002
        # so that it knows how wide the prompt is.
        local b=$'\001'"$cb"$'\002' d=$'\001'"$cdim"$'\002' r=$'\001'"$cr"$'\002'
        IFS= read -e -r -p "$b$2$r${3:+ ${d}[$3]$r} " a || ok=1
      else
        printf '%s%s%s%s ' "$cb" "$2" "$cr" "${3:+ ${cdim}[$3]$cr}" >&2
        IFS= read -r a || ok=1
      fi
      [ "$ok" = 0 ] || { echo >&2; echo "apod: cancelled, nothing written" >&2; exit 2; }
      printf -v "$1" '%s' "${a:-${3:-}}"
    }
    confirm() { local y; ask y "$1" "$2"; [[ $y =~ ^[Yy] ]]; }  # confirm QUESTION y|n (the default)
    note() { printf '%s%s%s\n' "$cdim" "$*" "$cr" >&2; }
    warn() { printf '%s%s%s\n' "$cy" "$*" "$cr" >&2; }
    section() { printf '\n%s%s%s\n' "$cb" "$*" "$cr" >&2; }
    tq() { local s=${1//\\/\\\\}; printf '"%s"' "${s//\"/\\\"}"; }  # a TOML string
    tlist() { local out="" v; for v in "$@"; do out+="${out:+, }$(tq "$v")"; done; printf '[%s]' "$out"; }
    tilde() { case $1 in "$HOME"/*) printf '%s/%s' "~" "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }
    mountpath() {  # mountpath VAR MODE QUESTION: an existing path apod would mount, or empty
      local mp err rc
      while :; do
        ask mp "$3"; mp=${mp/#\~/$HOME}
        if [ -z "$mp" ]; then printf -v "$1" '%s' ""; return; fi
        if [ ! -e "$mp" ]; then warn "No such path: $mp"; continue; fi
        mp=$(realpath -m "$mp")  # absolute: profile.toml is read from other folders
        # The loader's mount guard: apod's own files can't be mounted (exit 2: refused; else it broke).
        rc=0; err=$(python3 "$apoddir/apod-broker" profile --"$2" "$mp" --quiet 2>&1 >/dev/null) || rc=$?
        if [ "$rc" = 0 ]; then printf -v "$1" '%s' "$mp"; return; fi
        [ "$rc" = 2 ] || { echo "apod: couldn't check the mount: $err" >&2; exit 2; }
        warn "${err#apod: }"
      done
    }
    keypath() {  # keypath VAR QUESTION: an existing private key with its .pub, or empty
      local k
      while :; do
        ask k "$2"; k=${k/#\~/$HOME}
        if [ -z "$k" ] || { [ -f "$k" ] && [ -f "$k.pub" ]; }; then printf -v "$1" '%s' "${k:+$(realpath -m "$k")}"; return; fi
        warn "No key at $k (with $k.pub next to it)."
      done
    }

    name=${2:-}
    while :; do
      [ -n "$name" ] || ask name "Profile name:"
      # The names a profile can't have, and where it would be: paths.py.
      if ! err=$(python3 "$apoddir/apod-broker" paths --check-name "$name" 2>&1); then warn "${err#apod: }"
      else
        load_paths --profile "$name"
        if [ "$(P .profile.exists)" = true ]; then
          warn "$(P '.profile.dir // .profile.file') already exists: edit it instead (docs/reference.md#profiletoml)."; [ -z "${2:-}" ] || exit 2
        else break; fi
      fi
      name=
    done
    pfile=$(P .profile.file); phome=$(P .profile.home)

    section "Role"
    note "What the agent may do without asking; anything else waits for your approval. The steps"
    note "below offer to add what it lacks for what you set up, for this profile only (allow = [...])."
    declare -A roleallow=(); roles=()
    while IFS=$'\t' read -r r desc acts; do
      roles+=("$r"); roleallow[$r]=$acts; printf '  %s%-12s%s %s\n' "$cb" "$r" "$cr" "$desc" >&2
    done < <(python3 "$apoddir/apod-broker" roles --plain 2>/dev/null)
    role=""
    while :; do ask role "Role:" dev; [[ " ${roles[*]} " == *" $role "* ]] && break; warn "No role $role."; done
    extra=()  # the profile's additions to the role
    role_has() {  # role_has ACTION: the role, or what this profile adds, allows it
      local p pats; IFS=, read -ra pats <<< "${roleallow[$role]:-}"
      # shellcheck disable=SC2053 # the role's entries are patterns
      for p in "${pats[@]}" "${extra[@]}"; do [[ $1 == $p ]] && return 0; done
      return 1
    }
    offer() {  # offer WHAT ACTION...: when the role lacks the first action, add them for this profile?
      local what=$1; shift
      role_has "$1" && return 0
      if confirm "Role $role doesn't $what without asking. Allow it for this profile ($*)?" y; then extra+=("$@")
      else note "Then each one waits for your approval."; fi
    }

    section "GitHub"
    note "The broker runs gh and git pushes for the pod as a host gh login; its token never enters"
    note "the pod. Use a separate account for the agent (a bot), with access to its repositories."
    accounts=()
    if command -v gh >/dev/null; then
      mapfile -t accounts < <(gh auth status --hostname github.com 2>&1 | sed -n 's/.*Logged in to github\.com account \([^ ]*\).*/\1/p')
    fi
    if [ ${#accounts[@]} -gt 0 ]; then note "Logged in to the host's gh: ${accounts[*]}"
    else note "No account is logged in to the host's gh yet."; fi
    ask ghuser "GitHub account for the agent (empty: no GitHub):"
    ghnew=
    if [ -n "$ghuser" ] && [[ " ${accounts[*]} " != *" $ghuser "* ]]; then
      ghnew=1; warn "$ghuser isn't logged in to the host's gh: log it in before launching (below)."
    fi

    section "Git identity"
    hname=$(git config --global user.name || true); hemail=$(git config --global user.email || true)
    gname=""; gemail=""
    if [ -n "$hemail" ]; then note "Commits are by your host's git identity, $hname <$hemail>, unless you choose another."
    else note "Your host's git config has no user.email: the profile needs an identity of its own."; fi
    bot=
    if [ -n "$ghuser" ] && command -v gh >/dev/null; then
      id=$(gh api "users/$ghuser" --jq .id 2>/dev/null || true)
      [ -z "$id" ] || bot="$id+$ghuser@users.noreply.github.com"
    fi
    if [ -n "$bot" ] && confirm "Commit as $ghuser <$bot>?" "$([ -n "$hemail" ] && echo n || echo y)"; then
      gname=$ghuser gemail=$bot
    elif [ -z "$hemail" ] || confirm "Commit as someone else?" n; then
      while [ -z "$gname" ]; do ask gname "Name:"; done
      while [[ ! $gemail =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]]; do ask gemail "Email:"; done
    fi

    section "Signing commits"
    note "The broker signs the pod's commits and tags with an SSH key it holds on the host."
    newsign=; signkey=
    ask signkey "Signing key (a private key; 'new' creates one; empty: no signing):"
    if [ "$signkey" = new ]; then
      signkey=$HOME/.ssh/id_apod_${name}_sign; newsign=1
      [ ! -e "$signkey" ] || { warn "$signkey exists: using it."; newsign=; }
    elif [ -n "$signkey" ]; then
      signkey=$(realpath -m "${signkey/#\~/$HOME}")
      [ -f "$signkey" ] && [ -f "$signkey.pub" ] || keypath signkey "No key there (with its .pub). Signing key (empty: none):"
    fi
    [ -z "$signkey" ] || offer "sign commits" git-sign:commit git-sign:tag

    section "SSH"
    note "Hosts the agent may reach, through the broker, by their names in your ~/.ssh/config."
    h=""; ask h "Hosts, separated by spaces or commas (empty: none):"; read -ra hosts <<< "${h//,/ }"
    sshkey=
    [ ${#hosts[@]} -eq 0 ] || while [ -z "$sshkey" ]; do keypath sshkey "Key it logs in with (a private key):"; done
    [ -z "$sshkey" ] || offer "log in over ssh" ssh:connect ssh:login

    rad=
    if command -v rad >/dev/null; then
      section "Radicle"
      confirm "Push to the project's rad:// remotes (autodetect)?" n && rad=1
      [ -z "$rad" ] || offer "push to Radicle" "rad:push branch" "rad:push patch"
    fi

    section "Notifications"
    notify=
    confirm "May the agent send you desktop notifications?" n && notify=1
    [ -z "$notify" ] || offer "send notifications" notify:send

    section "Pasting images"
    note "Images you paste into the agent (Ctrl+V) come from your clipboard through the broker;"
    note "text never does."
    clip=
    confirm "Paste images from your clipboard?" n && clip=1
    [ -z "$clip" ] || offer "read the clipboard's image" clipboard:image

    broker=; [ -z "$ghuser$signkey$sshkey$rad$notify$clip" ] || broker=1
    scope=()
    if [ -n "$broker" ]; then
      section "Scope"
      note "The scope is where: the launch folder's remotes are in it already; add more here."
      # Not ssh (the hosts above are its scope) nor git-local (the launch folder is in already).
      kinds=$(python3 "$apoddir/apod-broker" scopes 2>/dev/null | sed -n 's/^\([a-z][a-z0-9-]*\): .*/\1/p' |
        grep -vx 'ssh\|git-local' | paste -sd ' ')
      note "Kinds: $kinds (e.g. gh:ORG/* for every repository of ORG); ssh hosts are the ones above."
      while :; do
        s=""; ask s "More scope, separated by spaces or commas (empty: none):"
        read -ra scope <<< "${s//,/ }"; bad=
        for e in "${scope[@]}"; do [[ " $kinds " == *" ${e%%:*} "* && $e == *:?* ]] || bad+=" $e"; done
        [ -z "$bad" ] && break
        warn "Not KIND:VALUE with a kind above:$bad"
      done
    fi

    section "Mounts"
    note "Files and folders the pod sees besides the launch folder, at the same paths. Tab completes"
    note "paths. One per line, an empty line ends the list."
    romounts=(); rwmounts=()
    while :; do mountpath m ro "Read-only path (empty: no more):"; [ -n "$m" ] || break; romounts+=("$m"); done
    while :; do mountpath m rw "Read-write path (empty: no more):"; [ -n "$m" ] || break; rwmounts+=("$m"); done

    section "Image"
    image=
    while :; do
      ask image "Image (empty: \$APOD_IMAGE, else apod):"
      [[ $image != *[[:space:]]* ]] && break
      warn "No spaces."
    done

    # profile.toml: the top-level keys first (a key after a [table] line belongs to that table).
    toml=
    if [ -n "$broker" ]; then
      toml+="role = $(tq "$role")"$'\n'
      [ ${#extra[@]} -eq 0 ] || toml+="allow = $(tlist "${extra[@]}")   # on top of the role, for this profile"$'\n'
      for h in "${hosts[@]}"; do scope+=("ssh:$h"); done  # the ssh hosts are scope entries too
      [ ${#scope[@]} -eq 0 ] || toml+="scope = $(tlist "${scope[@]}")"$'\n'
    else
      toml+="broker = false"$'\n'
    fi
    if [ -n "$image" ] || [ ${#romounts[@]} -gt 0 ] || [ ${#rwmounts[@]} -gt 0 ]; then
      toml+=$'\n[pod]\n'
      [ -z "$image" ] || toml+="image = $(tq "$image")"$'\n'
      if [ ${#romounts[@]} -gt 0 ]; then
        paths=(); for m in "${romounts[@]}"; do paths+=("$(tilde "$m")"); done; toml+="ro = $(tlist "${paths[@]}")"$'\n'
      fi
      if [ ${#rwmounts[@]} -gt 0 ]; then
        paths=(); for m in "${rwmounts[@]}"; do paths+=("$(tilde "$m")"); done; toml+="rw = $(tlist "${paths[@]}")"$'\n'
      fi
    fi
    [ -z "$gemail" ] || toml+=$'\n[git]\n'"name = $(tq "$gname")"$'\n'"email = $(tq "$gemail")"$'\n'
    if [ -n "$broker" ]; then
      [ -z "$ghuser" ] || toml+=$'\n[gh]\n'"user = $(tq "$ghuser")"$'\n'
      [ -z "$signkey" ] || toml+=$'\n[git-sign]\n'"key = $(tq "$(tilde "$signkey")")"$'\n'
      [ -z "$sshkey" ] || toml+=$'\n[ssh]\n'"key = $(tq "$(tilde "$sshkey")")"$'\n'
      [ -z "$rad" ] || toml+=$'\n[rad]\nautodetect = true\n'
      [ -z "$notify" ] || toml+=$'\n[notify]\nenabled = true\n'
      [ -z "$clip" ] || toml+=$'\n[clipboard]\nenabled = true\n'
    fi

    section "The profile"
    note "$phome/    the pod's home (Claude's login, settings, history)"
    note "$pfile:"; printf '%s' "$toml" | sed 's/^/    /' >&2
    [ -z "$newsign" ] || note "and a new signing key, $(tilde "$signkey") (ssh-keygen asks for its passphrase)"
    [ -n "$broker" ] || note "No broker: the agent works on the launch folder, commits, and can't push."
    confirm "Create it?" y || { echo "apod: nothing written" >&2; exit 1; }

    if [ -n "$newsign" ]; then
      mkdir -p "$HOME/.ssh"
      ssh-keygen -q -t ed25519 -C "apod $name signing" -f "$signkey" || { echo "apod: ssh-keygen failed, nothing written" >&2; exit 1; }
    fi
    mkdir -p "$phome" "$(dirname "$pfile")"
    printf '%s' "$toml" > "$pfile"
    section "Created $(P '.profile.dir // .profile.file'). Next:"
    [ -z "$ghnew" ] || echo "  gh auth login --hostname github.com   # as $ghuser; then gh auth switch back to yours" >&2
    if [ -n "$signkey" ] && [ -n "$ghuser" ]; then
      echo "  # Verified signatures on GitHub: add $(tilde "$signkey").pub as a signing key of the committing account" >&2
      echo "  # (Settings > SSH and GPG keys > New SSH key, type Signing)" >&2
    fi
    echo "  cd ~/src/some-repo && apod $name" >&2
    [ -z "$broker" ] || echo "  apod broker                            # in another terminal: approve what's outside the role" >&2
    exit ;;
  profiles)
    # token: the GitHub token the profile launches with (its own podman secret gh-<profile>, or
    # another profile's through [token] profile); "unused" when the broker replaces it.
    load_paths; used=()
    while IFS=$'\t' read -r p phome; do
      t=-; g=no; b=-
      # (stdin: the list of profiles; nothing in the loop may read it)
      if ! pj=$(python3 "$apoddir/apod-broker" profile --profile "$p" --quiet 2>&1 < /dev/null); then
        printf '%-24s %s\n' "$p" "invalid: ${pj#apod: }"; continue
      fi
      src=$(jq -r --arg p "$p" '.token.profile // $p' <<< "$pj")
      if podman secret exists "gh-$src" < /dev/null; then t=$([ "$src" = "$p" ] && echo set || echo "gh-$src"); fi
      [ -f "$phome/.config/google-docs-mcp/token.json" ] && g=yes
      if [ "$(jq -r .broker <<< "$pj")" = true ]; then
        b=$(jq -r '.role // "reader"' <<< "$pj")
        [ "$t" = - ] || t="unused"
      elif [ "$t" != - ]; then used+=("gh-$src"); fi
      printf '%-24s token: %-12s google: %-4s broker: %s\n' "$p" "$t" "$g" "$b"
    done < <(P '.all_profiles[] | [.name, .home] | @tsv')
    unused=()
    while read -r sec; do
      [[ " ${used[*]} " == *" $sec "* ]] || unused+=("$sec")
    done < <(podman secret ls --format '{{.Name}}' 2>/dev/null | grep '^gh-' | sort)
    if [ ${#unused[@]} -gt 0 ]; then
      echo "GitHub tokens no profile launches with: ${unused[*]} (remove: apod token PROFILE --rm, or podman secret rm NAME)"
    fi
    exit ;;
esac

[ $# -ge 1 ] || usage
profile=$1; shift
agent=claude
image=
proj=
climounts=()  # "mode path" entries from --ro/--rw, for this run only
connectors=() # claude.ai connector groups enabled for this run (-c)
role=      # broker role for this run (--role), else a preset's, else the profile's, else reader
nobroker=  # --no-broker: no broker for this run, even with a broker.toml
ghuser=    # --gh-user: the host gh account the broker acts as for this run, over [gh] user
scopes=()     # extra broker scope for this run (--scope)
presets=()    # presets for this run (-p), applied in order over the profile's [pod], role and scope
recopts=("$profile")  # profile and options of this launch, for the history and apod resume
while [ $# -gt 0 ]; do
  case $1 in
    -a)         [ $# -ge 2 ] || usage; agent=$2; recopts+=("$1" "$2"); shift 2 ;;
    -p|--preset) [ $# -ge 2 ] || usage; IFS=, read -ra prs <<< "$2"; presets+=("${prs[@]}"); recopts+=("$1" "$2"); shift 2 ;;
    -i|--image) [ $# -ge 2 ] || usage; image=$2; recopts+=("$1" "$2"); shift 2 ;;
    -c|--connectors) [ $# -ge 2 ] || usage; IFS=, read -ra cs <<< "$2"; connectors+=("${cs[@]}"); recopts+=("$1" "$2"); shift 2 ;;
    -m|--ro)    [ $# -ge 2 ] || usage; climounts+=("ro $2"); recopts+=(--ro "$(realpath -m "$2")"); shift 2 ;;
    --rw)       [ $# -ge 2 ] || usage; climounts+=("rw $2"); recopts+=(--rw "$(realpath -m "$2")"); shift 2 ;;
    --role)     [ $# -ge 2 ] || usage; role=$2; recopts+=("$1" "$2"); shift 2 ;;
    --persona)  [ $# -ge 2 ] || usage; role=$2; recopts+=(--role "$2"); shift 2
                echo "apod: --persona is now --role" >&2 ;;
    --no-broker) nobroker=1; recopts+=("$1"); shift ;;
    --gh-user)  [ $# -ge 2 ] || usage; ghuser=$2; recopts+=("$1" "$2"); shift 2 ;;
    --scope)    [ $# -ge 2 ] || usage; scopes+=("$2"); recopts+=("$1" "$2"); shift 2 ;;
    --)         shift; break ;;
    -*)         usage ;;
    *)          [ -z "$proj" ] || usage; proj=$1; shift ;;
  esac
done
proj=$(realpath "${proj:-$PWD}")

# Where the profile is (a name apod can't take is refused there), its home, its work log...
load_paths --profile "$profile" --pid $$
phome=$(P .profile.home)
if [ "$(P .profile.exists)" != true ]; then
  known=$(P '.all_profiles | keys | join(" ")') lr=$(P .legacy_root)
  if [ "$(P .legacy)" = false ] && [ -d "$lr/$profile" ]; then  # (legacy) left beside the new layout
    echo "apod: no profile named $profile${known:+ (profiles: $known)}; $lr/$profile is a profile of the legacy layout, which isn't used once one of the new layout's folders is there (apod broker paths): apod migrate --layout $profile moves it" >&2
    exit 2
  fi
  echo "apod: no profile named $profile${known:+ (profiles: $known)}; to create it, see README, Quick start" >&2
  exit 2
fi
# The profile's settings, from its profile.toml (or its old files), checked, with the presets'
# over its own (-p): JSON from apod-broker profile. pget runs a jq filter on it; plist one
# that prints NUL-terminated records.
ldargs=(--profile "$profile" --project "$proj" --quiet)  # --ro/--rw: refused if they'd expose apod's own files
for e in "${climounts[@]}"; do ldargs+=(--"${e%% *}" "${e#* }"); done
for e in "${presets[@]}"; do ldargs+=(--preset "$e"); done
pjson=$(python3 "$apoddir/apod-broker" profile "${ldargs[@]}") || exit 2
pget() { jq -r "$@" <<< "$pjson"; }
plist() { jq -j "$1" <<< "$pjson"; }
# Image: -i, else the last preset's that sets one, else the profile's [pod] image, else $APOD_IMAGE,
# else apod. The loader has applied the presets: .pod is the profile's with theirs over it.
[ -n "$image" ] || image=$(pget '.pod.image // empty')
image=${image:-${APOD_IMAGE:-apod}}
# Network: podman's default (pasta) unless [pod] network says otherwise, e.g. "host" to share the
# host's network (Tailscale routes and DNS included, but also host localhost services).
network=$(pget '.pod.network // empty')
# Named podman volumes from [pod] volumes (e.g. a persistent /nix store). Podman fills an empty
# named volume from the image's content at that path.
volumes=(); volpaths=()
while IFS=$'\t' read -r vname vpath; do
  volumes+=(-v "$vname:$vpath"); volpaths+=("$vpath")
done < <(pget '.pod.volumes | to_entries[] | [.key, .value] | @tsv')

# Broker: when the profile uses it (broker = true, the default of a profile.toml; an old profile
# with a broker.toml), or --role, --scope or --gh-user is given, or a preset sets a role or a
# scope; --no-broker turns it off. The role comes from --role, else the last preset's that sets
# one, else the profile's, else reader. The presets' scope adds to the profile's, as --scope does:
# the broker reads the profile's file, not the presets, so theirs go to it as --role and --scope.
usebroker=
[ "$role" = none ] && { role=; nobroker=1; }  # the old way to say --no-broker
prole=$(pget '[.presets[].role | values] | last // empty')
pscopes=()
while IFS= read -r -d '' s; do pscopes+=("$s"); done < <(plist '.presets[].scope[] | "\(.)\u0000"')
if [ -n "$nobroker" ]; then
  [ ${#scopes[@]} -eq 0 ] && [ -z "$role" ] && [ -z "$ghuser" ] || { echo "apod: --role, --scope and --gh-user need the broker, which --no-broker turns off" >&2; exit 2; }
  [ -z "$prole" ] && [ ${#pscopes[@]} -eq 0 ] || {
    echo "apod: preset $(pget '[.presets[] | select(.role or (.scope | length > 0)) | .name] | join(",")') sets a role or a scope, which need the broker, which --no-broker turns off" >&2; exit 2; }
else
  [ -n "$role" ] || role=$prole
  scopes+=("${pscopes[@]}")
  if [ -n "$role" ] || [ ${#scopes[@]} -gt 0 ] || [ -n "$ghuser" ] || [ "$(pget .broker)" = true ]; then usebroker=1; fi
fi
# What the loader says (old profile files, a profile.toml beside them). With the broker, its
# session says it with its own warnings; here without.
if [ -z "$usebroker" ]; then
  while IFS= read -r w; do echo "apod: $w" >&2; done < <(pget '.warnings[]')
fi
ghsecret=()
if [ -z "$usebroker" ]; then
  # GitHub token: the podman secret gh-<profile>, or another profile's if [token] profile names one.
  # shellcheck disable=SC2016 # $p is jq's (--arg p)
  ghprofile=$(pget --arg p "$profile" '.token.profile // $p')
  ghsecret=(--secret "gh-$ghprofile,type=env,target=GH_TOKEN")
  if ! podman secret exists "gh-$ghprofile"; then
    echo "apod: profile $ghprofile has no GitHub token, so gh and HTTPS pushes are unauthenticated. Use the broker (profile.toml, or --role dev) or add a token: apod token $ghprofile" >&2
    ghsecret=()
  else
    echo "apod: profile $profile uses a GitHub token; the broker is recommended instead (broker = true in its profile.toml, see README)" >&2
  fi
fi
mkdir -p "$phome/.claude"
# SSH: [ssh-agent] key names a private key (ideally passphrase-protected, kept outside the
# profile's home). It's served for this run by a dedicated ssh-agent on the host; the pod gets the
# agent socket, never the key file.
sshkey=$(pget '.ssh_agent.key // empty')
[ -z "$sshkey" ] || [ -f "$sshkey" ] || { echo "apod: the ssh-agent key of profile $profile is a missing file: $sshkey" >&2; exit 2; }

case $agent in
  claude)   cmd=(claude --permission-mode bypassPermissions) ;;
  # --auto: no permission prompts (as bypassPermissions for Claude). --standalone: a private
  # server, not opencode's background service, which pods sharing a profile home would share.
  opencode) cmd=(opencode --auto --standalone) ;;
  bash)     cmd=(bash -l) ;;
  *) usage ;;
esac

# claude.ai connectors come with the Claude account, not the pod: off unless enabled with -c or
# the profile's [pod] connectors. -c replaces the profile's groups for the run; "none" turns off
# the groups before it: "-c none" all of them, and "-c gdoc -c none -c todoist" leaves todoist
# (apod resume adds a -c to the session's).
if [ ${#connectors[@]} -eq 0 ]; then
  while IFS= read -r -d '' c; do connectors+=("$c"); done < <(plist '.pod.connectors[] | "\(.)\u0000"')
fi
cs=(); for c in "${connectors[@]}"; do if [ "$c" = none ]; then cs=(); else cs+=("$c"); fi; done
connectors=("${cs[@]}")
ccloud=(); clocal=()  # claude.ai connector groups / local MCP servers
filemounts=()         # single files mounted over paths inside the extra mounts
for c in "${connectors[@]}"; do
  if [ -n "${connector_servers[$c]+x}" ]; then ccloud+=("$c")
  elif [[ " ${local_mcps[*]} " == *" $c "* ]]; then clocal+=("$c")
  else echo "apod: unknown connector '$c' (known: ${!connector_servers[*]} ${local_mcps[*]})" >&2; exit 2; fi
done
if [[ " ${ccloud[*]} " == *" gdoc "* && " ${clocal[*]} " == *" google-docs-mcp "* ]]; then
  echo "apod: use either gdoc or google-docs-mcp, not both (they overlap on Google Docs/Drive)" >&2; exit 2
fi
allowed=(); denied=()
for c in "${!connector_servers[@]}"; do
  for s in ${connector_servers[$c]}; do
    if [[ " ${ccloud[*]} " == *" $c "* ]]; then allowed+=("$s"); else denied+=("mcp__claude_ai_${s}__*"); fi
  done
done
if [ ${#allowed[@]} -eq 0 ]; then
  csettings='{"disableClaudeAiConnectors":true}'
else
  # Deny the known connectors not asked for (hides their tools) and, as a catch-all for
  # connectors not listed above, block any other claude.ai tool in a PreToolUse hook.
  re="^mcp__claude_ai_($(IFS='|'; echo "${allowed[*]}"))__"
  hook="t=\$(jq -r .tool_name); case \$t in mcp__claude_ai_*) echo \"\$t\" | grep -qE '$re' || { echo 'apod: connector not enabled for this run (apod -c)' >&2; exit 2; } ;; esac"
  csettings=$(jq -cn --arg hook "$hook" '$ARGS.positional as $deny
    | {permissions: {deny: $deny},
       hooks: {PreToolUse: [{matcher: "mcp__claude_ai_.*", hooks: [{type: "command", command: $hook}]}]}}' \
    --args "${denied[@]}")
fi
case $agent in
  claude) cmd+=(--settings "$csettings") ;;
  *) [ ${#connectors[@]} -eq 0 ] || echo "apod: -c only applies to claude; ignored for $agent" >&2; clocal=() ;;
esac
if [[ " ${clocal[*]} " == *" google-docs-mcp "* ]]; then
  [ -f "$gdocs_mcp/dist/index.js" ] || { echo "apod: google-docs-mcp isn't built: $gdocs_mcp/dist/index.js is missing" >&2; exit 2; }
  [ -f "$phome/.config/google-docs-mcp/token.json" ] || {
    echo "apod: profile $profile isn't signed in to Google. Run: apod google-auth $profile" >&2; exit 2; }
  climounts+=("ro $gdocs_mcp")
  gcred=$(P .profile.google_credentials)
  [ -f "$gcred" ] && filemounts+=(-v "$gcred:$gdocs_mcp/credentials.json:ro,z")
  cmd+=(--mcp-config "$(jq -cn --arg js "$gdocs_mcp/dist/index.js" --arg scopes "$gdocs_scopes" \
    '{mcpServers: {"google-docs-mcp": {command: "node", args: [$js],
      env: {GOOGLE_MCP_SCOPES: $scopes, MCP_LAZY_TOOLS: "1"}}}}')")
fi

# Session id for the history and apod resume: a new Claude run gets its own (--session-id), a
# --resume <id> run keeps that id; --continue, a bare --resume and other agents record none.
session=
if [ "$agent" = claude ]; then
  prev=; explicit=
  for a in "$@"; do
    case $a in --continue|-c|--resume|-r|--session-id) explicit=1 ;; esac
    case $prev in --resume|-r) [[ $a == -* ]] || session=$a ;; esac
    prev=$a
  done
  if [ -z "$explicit" ]; then session=$(uuidgen); cmd+=(--session-id "$session"); fi
fi

# Work log: a folder per session on the host (worklog/<id>/), mounted read-write, where the agent
# keeps notes on what it did, for reviews and work reports across sessions. A resumed Claude
# session keeps its log (same id); other launches start a new one.
worklog=${session:-$(uuidgen)}
wdir=$(P .worklog)/$worklog
if ! { mkdir -p "$wdir" && touch "$wdir/worklog.md"; }; then
  echo "apod: couldn't create the work log in $(P .worklog)" >&2; exit 2
fi

# Extra mounts: the profile's [pod] ro and rw, then --ro/--rw, which override the profile's mode
# for the same path. Each path is mounted once.
declare -A mmode=(); morder=()
want_mount() {  # <ro|rw> <path>; fails if the path doesn't exist
  local path p=$2
  # shellcheck disable=SC2088 # a literal ~, expanded right here
  case $p in "~"|"~/"*) p=$HOME${p#"~"} ;; esac  # only ~ and ~/..., as the loader that checked it
  path=$(realpath -m "$p")
  [ -e "$path" ] || return 1
  [ "$path" = "$proj" ] && return 0
  [ -n "${mmode[$path]+x}" ] || morder+=("$path")
  mmode[$path]=$1
}
while IFS= read -r -d '' rec; do
  want_mount "${rec%%$'\t'*}" "${rec#*$'\t'}" || echo "apod: skipping missing mount ${rec#*$'\t'}" >&2
done < <(plist '.pod.mounts[] | "\(.[0])\t\(.[1])\u0000"')
for e in "${climounts[@]}"; do
  want_mount "${e%% *}" "${e#* }" || { echo "apod: no such path: ${e#* }" >&2; exit 2; }
done
# A linked worktree (git worktree add; herdr makes these): its .git is a file pointing into the
# main repository's .git, which holds the worktree's HEAD and index (worktrees/NAME), and the
# objects, refs, config and hooks of them all. That .git is mounted read-write too, or git fails
# in the pod. The pod can rewrite its .git file and, once mounted, that .git: it's followed only
# when the main repository's own record of the worktree (worktrees/NAME/gitdir) points back at
# this folder, its commondir (if any) at that repository, and the repository doesn't contain
# the project (which would mount the tree around it).
firstline() { sed -n '1{s/\r$//;p;q}' "$1"; }
inpod() {  # <path>: in the project or an extra mount
  local m; for m in "$proj" "${!mmode[@]}"; do [[ $1/ == "$m"/* ]] && return 0; done; return 1
}
modeat() {  # <path>: rw or ro, from the deepest mount that holds it (podman mounts the deeper ones last); none, not in the pod
  local m top='' mode=''
  for m in "$proj" "${!mmode[@]}"; do
    [[ $1/ == "$m"/* ]] && [ ${#m} -gt ${#top} ] && { top=$m; mode=${mmode[$m]:-rw}; }
  done
  echo "$mode"
}
linked() {  # <gitdir> <common>: is <gitdir> the project's entry in <common>/worktrees?
  local back cm
  [ "$(basename "$(dirname "$1")")" = worktrees ] && [ -f "$1/gitdir" ] && [ -d "$2/objects" ] && [ -d "$2/refs" ] || return 1
  [[ $proj/ == "$2"/* ]] && return 1
  back=$(firstline "$1/gitdir"); [[ $back == /* ]] || back=$1/$back
  [ "$(realpath -m -- "$back")" = "$proj/.git" ] || return 1
  [ -f "$1/commondir" ] || return 0
  cm=$(firstline "$1/commondir"); [[ $cm == /* ]] || cm=$1/$cm
  [ "$(realpath -m -- "$cm")" = "$2" ]
}
gitcommon=; gd=
if [ -f "$proj/.git" ]; then
  gd=$(sed -n '1{s/\r$//;s/^gitdir: *//p;q}' "$proj/.git")
  [ -z "$gd" ] || gd=$(cd "$proj" && realpath -e -- "$gd" 2>/dev/null) || gd=
  if [ -n "$gd" ] && linked "$gd" "$(dirname "$(dirname "$gd")")"; then
    gitcommon=$(dirname "$(dirname "$gd")")
    if [[ $gitcommon/ == "$proj"/* ]]; then :  # in the project: mounted already
    elif [ -n "${mmode[$gitcommon]+x}" ]; then  # the mounts name it: their mode stands
      [ "${mmode[$gitcommon]}" = rw ] || echo "apod: $gitcommon is mounted read-only, as the mounts say: git in the pod can't commit" >&2
    else morder+=("$gitcommon"); mmode[$gitcommon]=rw; fi
  elif [ -z "$gd" ]; then
    echo "apod: $proj/.git points to no folder; git won't work in the pod" >&2
  elif ! inpod "$gd"; then  # in the project (a bare-repo layout) or a mount (a submodule's), git works
    echo "apod: $proj/.git points to $gd, which isn't mounted, and this folder isn't a worktree of a repository there; git won't work in the pod" >&2
  fi
fi
# The repository's worktrees' records (worktrees/NAME: HEAD, index, gitdir), in a folder that's in
# the pod already: the pod can write that folder, so it's taken only as git makes it, not a
# symlink (to anywhere, which apod would mount below, and relabel).
wtdir=; [ -n "$gitcommon" ] && wtdir=$gitcommon/worktrees
[ -z "$wtdir" ] && [ -d "$proj/.git" ] && wtdir=$proj/.git/worktrees
[ -z "$wtdir" ] && [ -n "$gd" ] && [ -d "$gd/worktrees" ] && wtdir=$gd/worktrees  # .git file to a repository
if [ -n "$wtdir" ] && [ -L "$wtdir" ]; then
  echo "apod: $wtdir is a symlink, which git doesn't make: the worktrees' records in it aren't made read-only" >&2; wtdir=
elif [ -n "$wtdir" ] && [ -d "$wtdir" ]; then
  wtdir=$(realpath -e -- "$wtdir" 2>/dev/null) || wtdir=  # through a symlinked .git, say
  [ -n "$wtdir" ] && [ -n "$(modeat "$wtdir")" ] || wtdir=
else wtdir=; fi
# Those of worktrees whose folders aren't in the pod (wtout): git there lists them as prunable
# (wtothers: locked ones excepted). Those of worktrees in the pod, writable there (wtrw: the
# project's own, for one).
wtothers=0; wtout=0; wtrw=()
if [ -n "$wtdir" ]; then
  for d in "$wtdir"/*/; do
    d=${d%/}
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    if [ -f "$d/gitdir" ]; then
      back=$(firstline "$d/gitdir"); [[ $back == /* ]] || back=$d/$back
      case $(modeat "$(dirname "$(realpath -m -- "$back")")") in
        rw) wtrw+=("$d"); continue ;;
        ro) continue ;;
      esac
    fi
    wtout=$((wtout + 1))
    [ -e "$d/locked" ] || wtothers=$((wtothers + 1))
  done
fi
# The records are read-only in the pod, those in wtrw excepted: git worktree prune deletes the
# record of a worktree whose folder is missing, and git worktree remove (git worktree remove -f -f,
# on a locked one) deletes it even when it can't delete the folder, which breaks that worktree on
# the host. A linked worktree's pod gets this even with no other worktree yet, for those the host
# adds while it runs. The cost: no git worktree add in the pod, git gc's reflog step fails on the
# others' reflogs (so the pod's gc skips it, below), and renaming a branch that another worktree
# has checked out leaves that worktree's HEAD on the old name (git renames the branch, then
# can't update that HEAD).
wtro=
if [ -n "$wtdir" ] && { [ -n "$gitcommon" ] || [ "$wtout" -gt 0 ]; }; then
  if [ -n "${mmode[$wtdir]+x}" ]; then  # the mounts name it: their mode stands
    [ "${mmode[$wtdir]}" = ro ] || echo "apod: $wtdir is mounted read-write, as the mounts say: git in the pod can delete the records of the worktrees that aren't mounted" >&2
  elif [ "$(modeat "$wtdir")" = rw ]; then wtro=$wtdir; fi  # else read-only already
fi

# Extra mounts go before the project so a project nested inside a read-only tree stays writable.
mounts=(-v "$phome:/home/agent:z" -v "$wdir:/run/apod-worklog:z")
romounts=(); rwmounts=()
for path in "${morder[@]}"; do
  if [ "${mmode[$path]}" = rw ]; then rwmounts+=("$path"); mounts+=(-v "$path:$path:z")
  else romounts+=("$path"); mounts+=(-v "$path:$path:ro,z"); fi
done
mounts+=("${filemounts[@]}" -v "$proj:$proj:z")
# After the project and the repository's .git, which may hold them.
if [ -n "$wtro" ]; then
  mounts+=(-v "$wtro:$wtro:ro,z")
  for d in "${wtrw[@]}"; do mounts+=(-v "$d:$d:z"); done
fi
# Share global agent instructions and skills read-only.
[ -f "$HOME/.claude/CLAUDE.md" ] && mounts+=(-v "$HOME/.claude/CLAUDE.md:/home/agent/.claude/CLAUDE.md:ro,z")
[ -d "$HOME/.claude/skills" ] && mounts+=(-v "$HOME/.claude/skills:/home/agent/.claude/skills:ro,z")
# Claude's registry of running sessions is one file per process id, and pods of a profile share a
# home and the same low pids: each pod keeps its own, so /rename and the like don't hit another's.
[ "$agent" = claude ] && mounts+=(--tmpfs "/home/agent/.claude/sessions:rw,mode=1777,size=1m")

# Broker session: the broker reads the profile (profile.toml), and the project's remotes
# (GitHub and Radicle remotes join the scope), and answers with what the pod needs: mounts,
# environment, git config, keys to load into its agent, and a note for the agent.
bsid=; binfo=; bproviders=; agentpid=
podopts=(); startcmds=  # from the broker's extensions: podman options, commands run in the pod first
# Set before registering, so that a Ctrl-C at a passphrase prompt doesn't leave the session behind.
cleanup() {
  [ -z "$agentpid" ] || kill "$agentpid" 2>/dev/null
  [ -z "${sock:-}" ] || rm -f "$sock"
  [ -z "$bsid" ] || python3 "$apoddir/apod-broker" unregister "$bsid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
if [ -n "$usebroker" ]; then
  # The broker reads the profile from where this run found it (the broker may run with another
  # environment).
  regargs=(--id "$(uuidgen | tr -d - | cut -c1-12)" --profile "$profile" --project "$proj")
  if [ "$(P .profile.dir)" != null ]; then regargs+=(--profile-dir "$(P .profile.dir)"); else regargs+=(--profile-file "$(P .profile.file)"); fi
  [ -z "$role" ] || regargs+=(--role "$role")
  [ -z "$ghuser" ] || regargs+=(--gh-user "$ghuser")
  [ -z "$network" ] || regargs+=(--network "$network")
  # In a herdr pane: the broker shows the pane as blocked while a request waits for approval.
  # Only for the agents herdr knows (the others, such as bash, have no state to report).
  if [ "${APOD_HERDR:-1}" != 0 ] && [ -n "${HERDR_PANE_ID:-}" ] && [ -n "${HERDR_SOCKET_PATH:-}" ] &&
     { [ "$agent" = claude ] || [ "$agent" = opencode ]; }; then
    regargs+=(--herdr-pane "$HERDR_PANE_ID" --herdr-socket "$HERDR_SOCKET_PATH" --herdr-agent "$agent")
  fi
  # In a Herdr app terminal (herdr-core): the broker writes the terminal's status (OSC 7501) as
  # blocked while a request waits, so it needs the terminal's device. Only for claude, which writes
  # its own status, so the app shows it as before once the request is decided. Not in a multiplexer
  # run inside one (HC_TERMINAL_ID is still set there), which keeps the sequence to itself.
  if [ "${APOD_HERDR:-1}" != 0 ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ "$agent" = claude ] &&
     [ -z "${TMUX:-}${STY:-}${ZELLIJ:-}${HERDR_PANE_ID:-}" ] && ttydev=$(tty 2>/dev/null); then
    regargs+=(--status-tty "$ttydev" --status-agent "$agent")
  fi
  for s in "${scopes[@]}"; do regargs+=(--scope "$s"); done
  while read -r _ url; do regargs+=(--remote "$url"); done < <(git -C "$proj" config --get-regexp '^remote\..*\.(url|pushurl)$' 2>/dev/null || true)
  bsid=${regargs[1]}
  binfo=$(python3 "$apoddir/apod-broker" register "${regargs[@]}") || exit 2
  bproviders=" $(jq -r '.providers | join(" ")' <<< "$binfo") "
  # Keys the broker's agent doesn't hold yet: ssh-add asks for their passphrases here.
  agentsock=$(jq -r .agent <<< "$binfo")
  ttyin=/dev/tty; { : < /dev/tty; } 2>/dev/null || ttyin=/dev/null
  # Colours when stderr is a terminal (and NO_COLOR isn't set): bold, dim, yellow, reset.
  cb=; cdim=; cy=; cr=
  if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then cb=$'\e[1m'; cdim=$'\e[2m'; cy=$'\e[1;33m'; cr=$'\e[0m'; fi
  nkeys=$(jq '.need_keys | length' <<< "$binfo"); ki=0
  keyttl=
  if [ "$nkeys" -gt 0 ]; then
    keyttl=$(python3 "$apoddir/apod-broker" paths --key-ttl) || exit 2
    echo "${cb}apod:${cr} the broker needs $nkeys key(s) unlocked; each stays unlocked for $keyttl." >&2
  fi
  while IFS=$'\t' read -r kpath kconfirm kpurpose; do
    [ -n "$kpath" ] || continue
    ki=$((ki + 1))
    printf '\n%s\n%s\n' "${cb}[$ki/$nkeys]${cr} ${cy}${kpurpose:-a key}${cr}  ${cdim}${kpath/#$HOME/\~}${cr}" \
      "${cdim}Its passphrase, or an empty line to skip (those requests will fail).${cr}" >&2
    addopts=(-q -t "$keyttl"); [ "$kconfirm" = true ] && addopts+=(-c)
    if [ "$kconfirm" = true ] && [ -z "${SSH_ASKPASS:-}" ] && [ ! -x /usr/libexec/openssh/ssh-askpass ]; then
      echo "apod: $kpath has confirm = true, which needs ssh-askpass to ask you on each use: sudo dnf install openssh-askpass" >&2
    fi
