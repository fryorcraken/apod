class Framer:
    """The response to the shim: one JSON object per line (stdout, stderr, exit status)."""

    def __init__(self, wfile):
        self.w, self.lock, self.broken = wfile, threading.Lock(), False

    def send(self, obj):
        with self.lock:
            if self.broken:
                return False
            try:
                self.w.write((json.dumps(obj) + "\n").encode())
                self.w.flush()
                return True
            except OSError:
                self.broken = True
                return False

    def data(self, stream, b):
        return self.send({"t": stream, "d": base64.b64encode(b).decode()})

    def msg(self, text):
        return self.data("err", f"apod gh broker: {text}\n".encode())


def run_gh(sess, req, tty, out, work):
    env = gh_env(token_for(sess.user), tty, req.repo)
    p = subprocess.Popen([gh_bin(), *req.argv], cwd=work, env=env,
                         stdin=subprocess.PIPE if req.stdin is not None else subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    def pump(src, name):
        for chunk in iter(lambda: src.read1(65536), b""):
            if not out.data(name, chunk):
                p.kill()
                break

    ts = [threading.Thread(target=pump, args=(p.stdout, "out"), daemon=True),
          threading.Thread(target=pump, args=(p.stderr, "err"), daemon=True)]
    for t in ts:
        t.start()
    if req.stdin is not None:
        try:
            p.stdin.write(req.stdin)
            p.stdin.close()
        except OSError:
            pass
    for t in ts:
        t.join()
    return p.wait()


def handle_gh(h, sess, body):
    try:
        r = json.loads(body)
        argv = [str(a) for a in r.get("argv", [])]
        ctx = r.get("ctx") or {}
        files = {k: base64.b64decode(v) for k, v in (r.get("files") or {}).items()}
        stdin = base64.b64decode(r["stdin"]) if r.get("stdin") is not None else None
        tty = int(r.get("tty") or 0)
    except (ValueError, TypeError, KeyError):
        h.send_error(400)
        return
    h.send_response(200)
    h.send_header("Content-Type", "application/x-ndjson")
    h.send_header("Connection", "close")
    h.end_headers()
    out = Framer(h.wfile)
    (BDIR / "tmp").mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(dir=BDIR / "tmp") as work:
        work = Path(work)
        try:
            req = classify_gh(sess, argv, ctx, files, stdin, work)
        except BrokerError as e:
            out.msg(str(e))
            out.send({"t": "exit", "code": 1})
            return
        req.stdin = stdin
        if req.help:
            code = run_gh(sess, req, tty, out, work)
            out.send({"t": "exit", "code": code})
            return
        ev = new_event(sess, req)

        def waiting(ev):
            out.msg(f"`{req.display}` needs your approval ({ev['reason']}). Waiting up to "
                    f"{ASK_TIMEOUT:.0f}s. On the host: apod gh allow {ev['id']} [--session|--persona], "
                    f"apod gh deny {ev['id']}, or apod gh ui")

        try:
            ok = authorize(sess, req, ev, waiting)
        except BrokerError as e:
            ev.update(decision="error", reason=str(e))
            ok = False
        if not ok:
            log_event(ev)
            out.msg(f"rejected ({ev['decision']}): `{req.display}`: {ev['reason']}. "
                    f"The user can allow it (apod gh allow {ev['id']} --session) and you can retry.")
            out.send({"t": "exit", "code": 1})
            return
        try:
            code = run_gh(sess, req, tty, out, work)
        except BrokerError as e:
            out.msg(str(e))
            code = 1
        ev["exit"] = code
        log_event(ev)
        if code == 0 and req.created:
            with LOCK:
                sess.add_scope(("repo", req.created))
                sess.save()
            out.msg(f"added {req.created} to this session's scope")
        for note in req.notes if code == 0 else []:
            out.msg(note)
        out.send({"t": "exit", "code": code})


