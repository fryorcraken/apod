#!/usr/bin/env bash
# apod <profile> [-a claude|opencode|bash] [-c CONNECTORS] [--ro PATH]... [--rw PATH]... [project-dir] [-- agent args...]
# Run a coding agent in a podman container as a given GitHub identity.
# Per profile: ~/.agent-pod/<profile>/home (persistent $HOME), ~/.agent-pod/<profile>/env
# (git identity), ~/.agent-pod/<profile>/mounts (optional extra mounts), and the podman
# secret gh-<profile> (GitHub token).
set -euo pipefail

usage() { echo "usage: apod <profile> [-a claude|opencode|bash] [-c CONNECTORS] [--ro PATH]... [--rw PATH]... [project-dir] [-- agent args...]" >&2; exit 2; }

# claude.ai connector groups for -c, and the connector servers each one enables.
declare -A connector_servers=(
  [notion]="Notion"
  [gdoc]="Google_Docs Google_Drive Google_Sheets"
  [todoist]="Todoist"
  [canva]="Canva"
  [lovable]="Lovable"
  [jitsu]="UTS_Jitsu"
  [claudedocs]="Claude_Docs"
)
# For shell completion.
if [ "${1:-}" = --list-connectors ]; then printf '%s\n' "${!connector_servers[@]}" | sort; exit 0; fi

[ $# -ge 1 ] || usage
profile=$1; shift
agent=claude
proj=
climounts=()  # "mode path" entries from --ro/--rw, for this run only
connectors=() # claude.ai connector groups enabled for this run (-c)
while [ $# -gt 0 ]; do
  case $1 in
    -a)         [ $# -ge 2 ] || usage; agent=$2; shift 2 ;;
    -c|--connectors) [ $# -ge 2 ] || usage; IFS=, read -ra cs <<< "$2"; connectors+=("${cs[@]}"); shift 2 ;;
    -m|--ro)    [ $# -ge 2 ] || usage; climounts+=("ro $2"); shift 2 ;;
    --rw)       [ $# -ge 2 ] || usage; climounts+=("rw $2"); shift 2 ;;
    --)         shift; break ;;
    -*)         usage ;;
    *)          [ -z "$proj" ] || usage; proj=$1; shift ;;
  esac
done
proj=$(realpath "${proj:-$PWD}")

root=${APOD_ROOT:-$HOME/.agent-pod}
phome=$root/$profile/home
envf=$root/$profile/env
image=${APOD_IMAGE:-apod}

[ -f "$envf" ] || { echo "apod: missing $envf (git identity, see README)" >&2; exit 2; }
podman secret exists "gh-$profile" || { echo "apod: missing podman secret gh-$profile (see README)" >&2; exit 2; }
mkdir -p "$phome/.claude"

case $agent in
  claude)   cmd=(claude --permission-mode bypassPermissions) ;;
  opencode) cmd=(opencode) ;;
  bash)     cmd=(bash -l) ;;
  *) usage ;;
esac

# claude.ai connectors come with the Claude account, not the pod: off unless enabled with -c.
for c in "${connectors[@]}"; do
  [ -n "${connector_servers[$c]+x}" ] || { echo "apod: unknown connector '$c' (known: ${!connector_servers[*]})" >&2; exit 2; }
done
allowed=(); denied=()
for c in "${!connector_servers[@]}"; do
  for s in ${connector_servers[$c]}; do
    if [[ " ${connectors[*]} " == *" $c "* ]]; then allowed+=("$s"); else denied+=("mcp__claude_ai_${s}__*"); fi
  done
done
if [ ${#allowed[@]} -eq 0 ]; then
  csettings='{"disableClaudeAiConnectors":true}'
else
  # Deny the known connectors not asked for (hides their tools) and, as a catch-all for
  # connectors not listed above, block any other claude.ai tool in a PreToolUse hook.
  re="^mcp__claude_ai_($(IFS='|'; echo "${allowed[*]}"))__"
  hook="t=\$(jq -r .tool_name); case \$t in mcp__claude_ai_*) echo \"\$t\" | grep -qE '$re' || { echo 'apod: connector not enabled for this run (apod -c)' >&2; exit 2; } ;; esac"
  csettings=$(jq -cn --arg hook "$hook" '$ARGS.positional as $deny
    | {permissions: {deny: $deny},
       hooks: {PreToolUse: [{matcher: "mcp__claude_ai_.*", hooks: [{type: "command", command: $hook}]}]}}' \
    --args "${denied[@]}")
fi
case $agent in
  claude) cmd+=(--settings "$csettings") ;;
  *) [ ${#connectors[@]} -eq 0 ] || echo "apod: -c only applies to claude; ignored for $agent" >&2 ;;
esac

# Extra mounts: the profile's mounts file (one path per line, read-only unless prefixed "rw "),
# then --ro/--rw, which override the file's mode for the same path. Each path is mounted once.
declare -A mmode=(); morder=()
want_mount() {  # <ro|rw> <path>; fails if the path doesn't exist
  local path; path=$(realpath -m "${2/#\~/$HOME}")
  [ -e "$path" ] || return 1
  [ "$path" = "$proj" ] && return 0
  [ -n "${mmode[$path]+x}" ] || morder+=("$path")
  mmode[$path]=$1
}
if [ -f "$root/$profile/mounts" ]; then
  while read -r mode path; do
    case $mode in ''|'#'*) continue ;; rw|ro) ;; *) path=$mode; mode=ro ;; esac
    want_mount "$mode" "$path" || echo "apod: skipping missing mount $path" >&2
  done < "$root/$profile/mounts"
fi
for e in "${climounts[@]}"; do
  want_mount "${e%% *}" "${e#* }" || { echo "apod: no such path: ${e#* }" >&2; exit 2; }
done

# Extra mounts go before the project so a project nested inside a read-only tree stays writable.
mounts=(-v "$phome:/home/agent:z")
romounts=(); rwmounts=()
for path in "${morder[@]}"; do
  if [ "${mmode[$path]}" = rw ]; then rwmounts+=("$path"); mounts+=(-v "$path:$path:z")
  else romounts+=("$path"); mounts+=(-v "$path:$path:ro,z"); fi
done
mounts+=(-v "$proj:$proj:z")
# Share global agent instructions and skills read-only.
[ -f "$HOME/.claude/CLAUDE.md" ] && mounts+=(-v "$HOME/.claude/CLAUDE.md:/home/agent/.claude/CLAUDE.md:ro,z")
[ -d "$HOME/.claude/skills" ] && mounts+=(-v "$HOME/.claude/skills:/home/agent/.claude/skills:ro,z")

# Tell the agent where it is and what it can see (Claude: appended to its system prompt).
context="You are running inside an apod container (podman), profile \"$profile\". Only these host paths are mounted:
- $proj (read-write, the project)"
for p in "${rwmounts[@]}"; do context+=$'\n'"- $p (read-write)"; done
for p in "${romounts[@]}"; do context+=$'\n'"- $p (read-only)"; done
context+=$'\n'"Nothing else from the host is available. gh and git push over HTTPS use this profile's GitHub token. There are no permission prompts: the container is the isolation boundary."
if [ ${#connectors[@]} -gt 0 ]; then
  context+=$'\n'"claude.ai connectors enabled for this run: ${connectors[*]}. Others are blocked."
else
  context+=$'\n'"claude.ai connectors (Notion, Google Docs, etc.) are disabled for this run; they can be enabled at launch with apod -c."
fi
if [ "$agent" = claude ]; then cmd+=(--append-system-prompt "$context"); fi

tty=(-i); [ -t 0 ] && tty+=(-t)

# Rewrite GitHub SSH remotes, including github-* host aliases from ~/.ssh/config, to HTTPS
# so pushes authenticate with the profile's token.
rewrites=(git@github.com: ssh://git@github.com/)
if [ -f "$HOME/.ssh/config" ]; then
  while read -r alias; do rewrites+=("git@$alias:"); done < <(
    awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i ~ /^github-/) print $i }' "$HOME/.ssh/config")
fi
gitenv=(-e "GIT_CONFIG_COUNT=${#rewrites[@]}")
for i in "${!rewrites[@]}"; do
  gitenv+=(-e "GIT_CONFIG_KEY_$i=url.https://github.com/.insteadOf" -e "GIT_CONFIG_VALUE_$i=${rewrites[$i]}")
done

# herdr only sees podman in the pane; tell it which agent's screen to read. Podman doesn't pass
# this into the container.
case $agent in claude|opencode) export HERDR_AGENT=$agent ;; esac

exec podman run --rm "${tty[@]}" --userns=keep-id \
  --name "apod-$profile-$(basename "$proj")-$$" \
  --hostname "apod-$profile" \
  --secret "gh-$profile,type=env,target=GH_TOKEN" \
  --env-file "$envf" \
  -e HOME=/home/agent \
  -e APOD_PROFILE="$profile" \
  "${gitenv[@]}" \
  "${mounts[@]}" -w "$proj" \
  "$image" bash -lc 'gh auth setup-git >/dev/null 2>&1 || true; exec "$@"' _ "${cmd[@]}" "$@"
