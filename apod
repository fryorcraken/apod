#!/usr/bin/env bash
# apod <profile> [-a claude|opencode|bash] [-i IMAGE] [-c CONNECTORS] [--ro PATH]... [--rw PATH]... [--role R] [--scope S]... [--no-broker] [project-dir] [-- agent args...]
# Run a coding agent in a podman container as a given GitHub identity.
# Per profile: ~/.agent-pod/<profile>/home (persistent $HOME), ~/.agent-pod/<profile>/env
# (git identity), ~/.agent-pod/<profile>/mounts (optional extra mounts), and either the podman
# secret gh-<profile> (GitHub token), or ~/.agent-pod/<profile>/broker.toml: no credentials in the
# pod, the host's apod broker acts for it (gh, GitHub and Radicle remotes, commit signing, ssh).
set -euo pipefail

usage() {
  echo "usage: apod <profile> [-a claude|opencode|bash] [-i IMAGE] [-c CONNECTORS] [--ro PATH]... [--rw PATH]... [--role R] [--scope S]... [--no-broker] [project-dir] [-- agent args...]" >&2
  echo "       apod resume [--list|--latest|--claude] [dir] | history | ps | profiles | token <profile> [--rm] | google-auth <profile>" >&2
  echo "       apod broker [ui]|log [-f]|pending|allow ID [--session|--role]|deny ID|sessions|roles|grants|keys|restart|stop" >&2
  exit 2
}

# claude.ai connector groups for -c, and the connector servers each one enables.
declare -A connector_servers=(
  [notion]="Notion"
  [gdoc]="Google_Docs Google_Drive Google_Sheets"
  [todoist]="Todoist"
  [canva]="Canva"
  [lovable]="Lovable"
  [utsjitsu]="UTS_Jitsu"
  [claudedocs]="Claude_Docs"
)
# Local MCP servers for -c, run in the pod from a read-only mount of their checkout.
# google-docs-mcp: OAuth client from the profile's google-credentials.json if present (mounted over
# the checkout's credentials.json in the pod), else the checkout's; Google login per profile
# (apod google-auth <profile>), limited to these scopes for both sign-in and use.
local_mcps=(google-docs-mcp)
gdocs_mcp=${APOD_GDOCS_MCP:-$HOME/src/fryorcraken/google-docs-mcp}
gdocs_scopes=${APOD_GDOCS_SCOPES:-docs,sheets,slides,drive}
# Identity of the terminal tab, recorded with each launch so apod resume can go straight to the
# session a tab started: the first set variable among $APOD_PANE_ENV (default: herdr's pane id,
# then HC_SCOPE), as "NAME:value". Empty when none is set; resume then always lists.
pane_id() {
  local v
  for v in ${APOD_PANE_ENV:-HERDR_PANE_ID HC_SCOPE}; do
    if [ -n "${!v:-}" ]; then echo "$v:${!v}"; return; fi
  done
}
# This checkout: the broker (apod-broker, broker/) lives next to apod.
apoddir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
# For shell completion.
if [ "${1:-}" = --list-roles ]; then python3 "$apoddir/apod-broker" roles 2>/dev/null | sed -n 's/^\([^ :]*\):.*/\1/p'; exit 0; fi
if [ "${1:-}" = --list-connectors ]; then printf '%s\n' "${!connector_servers[@]}" "${local_mcps[@]}" | sort; exit 0; fi

# Subcommands: manage a profile's GitHub token (podman secret gh-<profile>) and Google login,
# list profiles.
case ${1:-} in
  broker|gh)
    # The broker: approvals, log, sessions, keys (see apod-broker).
    shift; [ $# -ge 1 ] || set -- ui
    exec python3 "$apoddir/apod-broker" "$@" ;;
  google-auth)
    [ $# -ge 2 ] || { echo "usage: apod google-auth <profile>" >&2; exit 2; }
    pdir=${APOD_ROOT:-$HOME/.agent-pod}/$2
    [ -d "$pdir" ] || { echo "apod: no profile $2" >&2; exit 2; }
    mkdir -p "$pdir/home/.config"
    client=()
    if [ -f "$pdir/google-credentials.json" ]; then
      client=(GOOGLE_CLIENT_ID="$(jq -r '(.installed // .web).client_id' "$pdir/google-credentials.json")"
              GOOGLE_CLIENT_SECRET="$(jq -r '(.installed // .web).client_secret' "$pdir/google-credentials.json")")
    fi
    echo "apod: Google sign-in for profile $2 (scopes: $gdocs_scopes), saved under $pdir/home/.config/google-docs-mcp/" >&2
    exec env -u GOOGLE_CLIENT_ID -u GOOGLE_CLIENT_SECRET -u GOOGLE_MCP_PROFILE "${client[@]}" \
      XDG_CONFIG_HOME="$pdir/home/.config" GOOGLE_MCP_SCOPES="$gdocs_scopes" \
      node "$gdocs_mcp/dist/index.js" auth ;;
  token)
    [ $# -ge 2 ] || { echo "usage: apod token <profile> [--rm]" >&2; exit 2; }
    if [ "${3:-}" = --rm ]; then
      podman secret rm "gh-$2" >/dev/null && echo "apod: removed token for $2"
      exit
    fi
    read -rsp "GitHub token for $2: " tok; echo >&2
    [ -n "$tok" ] || { echo "apod: empty token, nothing stored" >&2; exit 2; }
    printf %s "$tok" | podman secret create --replace "gh-$2" - >/dev/null
    login=$(GH_TOKEN=$tok gh api user --jq .login 2>/dev/null) || login="unknown (gh api user failed)"
    unset tok
    echo "apod: stored token for $2 (podman secret gh-$2), GitHub account: $login"
    echo "apod: the broker is recommended instead of tokens: no credentials in the pod, and you approve what's out of scope (see README, Broker)" >&2
    exit ;;
  history)
    # Folders and profiles launched, most recent first (from history.jsonl, one line per launch).
    hist=${APOD_ROOT:-$HOME/.agent-pod}/history.jsonl
    [ -f "$hist" ] || { echo "apod: no launches recorded yet" >&2; exit 0; }
    jq -rs 'group_by([.project, .profile]) | map(max_by(.ts) + {n: length}) | sort_by(.ts) | reverse | .[]
      | [(.ts | strflocaltime("%Y-%m-%d %H:%M")), .profile, "\(.n)x", .project] | @tsv' "$hist" | column -t -s $'\t'
    exit ;;
  ps)
    podman ps --filter label=apod.profile --format json | jq -r '.[] | [.Labels["apod.profile"],
      (.Labels["apod.session"] // "" | .[:8]), .Status, .Labels["apod.project"]] | @tsv' | column -t -s $'\t'
    exit ;;
  resume)
    # Resume a stopped Claude session started in a folder (one launched by apod, with a saved
    # conversation), with the same profile and options. In a herdr pane that launched one of them,
    # resume that one; otherwise list them and ask. --list always asks, --latest takes the newest,
    # --claude opens Claude's own picker for the latest launch's profile.
    shift; mode=ask; dir=
    for a in "$@"; do
      case $a in --list) mode=list ;; --latest) mode=latest ;; --claude) mode=claude ;;
        -*) echo "usage: apod resume [--list|--latest|--claude] [dir]" >&2; exit 2 ;; *) dir=$a ;; esac
    done
    here_pane=$(pane_id)
    dir=$(realpath "${dir:-$PWD}")
    root=${APOD_ROOT:-$HOME/.agent-pod}; hist=$root/history.jsonl
    [ -f "$hist" ] || { echo "apod: no launches recorded yet" >&2; exit 2; }
    running=$(podman ps --filter label=apod.session --format json | jq -r '.[].Labels["apod.session"] // empty')
    sids=(); lines=(); labels=(); panes=(); declare -A seen=()
    while IFS= read -r line; do
      mapfile -t opts < <(jq -r '.opts[]' <<< "$line")
      if [ "$mode" = claude ]; then exec "$0" "${opts[@]}" "$dir" -- --resume; fi
      sid=$(jq -r '.session // empty' <<< "$line")
      [ -n "$sid" ] && [ -z "${seen[$sid]+x}" ] || continue
      seen[$sid]=1
      grep -qx "$sid" <<< "$running" && continue
      tr=$(compgen -G "$root/${opts[0]}/home/.claude/projects/*/$sid.jsonl" | head -n1 || true)
      [ -n "$tr" ] || continue
      # Label: the /rename title if any, else the first prompt.
      title=$(jq -r 'select(.type == "custom-title") | .customTitle' "$tr" 2>/dev/null | tail -n1)
      [ -n "$title" ] || title=$(head -n 400 "$tr" | jq -r 'select(.type == "user" and (.isMeta | not))
        | .message.content | if type == "string" then . else (map(select(.type == "text").text) | join(" ")) end' 2>/dev/null \
        | grep -v '^<' | grep -m1 . | tr '\n' ' ')
      sids+=("$sid"); lines+=("$line"); panes+=("$(jq -r '.pane // empty' <<< "$line")")
      labels+=("$(date -r "$tr" '+%m-%d %H:%M')  ${opts[0]}  ${title:0:70}")
    done < <(jq -c --arg d "$dir" 'select(.project == $d and .agent == "claude")' "$hist" | tac)
    [ ${#sids[@]} -gt 0 ] || { echo "apod: nothing to resume in $dir (no stopped Claude session there with a saved conversation)" >&2; exit 2; }
    n=
    if [ "$mode" = latest ]; then n=1
    elif [ "$mode" = ask ] && [ -n "$here_pane" ]; then
      for i in "${!panes[@]}"; do
        if [ "${panes[$i]}" = "$here_pane" ]; then n=$((i + 1)); echo "apod: this tab ($here_pane) launched it (apod resume --list to choose another)" >&2; break; fi
      done
    fi
    if [ -z "$n" ]; then
      for i in "${!labels[@]}"; do printf '%2d) %s\n' "$((i + 1))" "${labels[$i]}" >&2; done
      read -rp "Resume which? [1] " n < /dev/tty; n=${n:-1}
      [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#sids[@]} ] || { echo "apod: no such choice" >&2; exit 2; }
    fi
    mapfile -t opts < <(jq -r '.opts[]' <<< "${lines[$((n - 1))]}")
    echo "apod: resuming ${labels[$((n - 1))]}" >&2
    exec "$0" "${opts[@]}" "$dir" -- --resume "${sids[$((n - 1))]}" ;;
  profiles)
    # token: the GitHub token the profile launches with (its own podman secret gh-<profile>, or
    # another profile's through its github file); "unused" when broker.toml replaces it.
    root=${APOD_ROOT:-$HOME/.agent-pod}; used=()
    for d in "$root"/*/; do
      p=$(basename "$d"); t=-; g=no; b=-
      [ "$p" = broker ] || [ "$p" = broker-extensions ] && continue
      src=$p; [ -f "$d/github" ] && src=$(head -n1 "$d/github" | tr -d '[:space:]')
      if podman secret exists "gh-$src"; then t=$([ "$src" = "$p" ] && echo set || echo "gh-$src"); fi
      [ -f "$d/home/.config/google-docs-mcp/token.json" ] && g=yes
      if [ -f "$d/broker.toml" ]; then
        b=$(sed -n 's/^\(role\|persona\) *= *"\(.*\)".*/\2/p' "$d/broker.toml" | head -n1); b=${b:-reader}
        [ "$t" = - ] || t="unused"
      elif [ "$t" != - ]; then used+=("gh-$src"); fi
      printf '%-24s token: %-12s google: %-4s broker: %s\n' "$p" "$t" "$g" "$b"
    done
    unused=()
    while read -r sec; do
      [[ " ${used[*]} " == *" $sec "* ]] || unused+=("$sec")
    done < <(podman secret ls --format '{{.Name}}' 2>/dev/null | grep '^gh-' | sort)
    if [ ${#unused[@]} -gt 0 ]; then
      echo "GitHub tokens no profile launches with: ${unused[*]} (remove: apod token PROFILE --rm, or podman secret rm NAME)"
    fi
    exit ;;
esac

[ $# -ge 1 ] || usage
profile=$1; shift
agent=claude
image=
proj=
climounts=()  # "mode path" entries from --ro/--rw, for this run only
connectors=() # claude.ai connector groups enabled for this run (-c)
role=      # broker role for this run (--role), else broker.toml's, else reader
nobroker=  # --no-broker: no broker for this run, even with a broker.toml
scopes=()     # extra broker scope for this run (--scope)
recopts=("$profile")  # profile and options of this launch, for the history and apod resume
while [ $# -gt 0 ]; do
  case $1 in
    -a)         [ $# -ge 2 ] || usage; agent=$2; recopts+=("$1" "$2"); shift 2 ;;
    -i|--image) [ $# -ge 2 ] || usage; image=$2; recopts+=("$1" "$2"); shift 2 ;;
    -c|--connectors) [ $# -ge 2 ] || usage; IFS=, read -ra cs <<< "$2"; connectors+=("${cs[@]}"); recopts+=("$1" "$2"); shift 2 ;;
    -m|--ro)    [ $# -ge 2 ] || usage; climounts+=("ro $2"); recopts+=(--ro "$(realpath -m "$2")"); shift 2 ;;
    --rw)       [ $# -ge 2 ] || usage; climounts+=("rw $2"); recopts+=(--rw "$(realpath -m "$2")"); shift 2 ;;
    --role)     [ $# -ge 2 ] || usage; role=$2; recopts+=("$1" "$2"); shift 2 ;;
    --persona)  [ $# -ge 2 ] || usage; role=$2; recopts+=(--role "$2"); shift 2
                echo "apod: --persona is now --role" >&2 ;;
    --no-broker) nobroker=1; recopts+=("$1"); shift ;;
    --scope)    [ $# -ge 2 ] || usage; scopes+=("$2"); recopts+=("$1" "$2"); shift 2 ;;
    --)         shift; break ;;
    -*)         usage ;;
    *)          [ -z "$proj" ] || usage; proj=$1; shift ;;
  esac
done
proj=$(realpath "${proj:-$PWD}")

root=${APOD_ROOT:-$HOME/.agent-pod}
phome=$root/$profile/home
envf=$root/$profile/env
# Image: -i, else the profile's image file (first line), else $APOD_IMAGE, else apod.
if [ -z "$image" ] && [ -f "$root/$profile/image" ]; then image=$(head -n1 "$root/$profile/image" | tr -d '[:space:]'); fi
image=${image:-${APOD_IMAGE:-apod}}
# Network: podman's default (pasta) unless the profile's network file says otherwise, e.g. "host"
# to share the host's network (Tailscale routes and DNS included, but also host localhost services).
network=
if [ -f "$root/$profile/network" ]; then network=$(head -n1 "$root/$profile/network" | tr -d '[:space:]'); fi
# Named podman volumes from the profile's volumes file, "NAME /path" per line (e.g. a persistent
# /nix store). Podman fills an empty named volume from the image's content at that path.
volumes=(); volpaths=()
if [ -f "$root/$profile/volumes" ]; then
  while read -r vname vpath; do
    case $vname in ''|'#'*) continue ;; esac
    volumes+=(-v "$vname:$vpath"); volpaths+=("$vpath")
  done < "$root/$profile/volumes"
fi

[ -f "$envf" ] || { echo "apod: missing $envf (git identity, see README)" >&2; exit 2; }
# Broker: when the profile has a broker.toml, or --role or --scope is given; --no-broker turns it
# off. The role comes from --role, else the profile's broker.toml, else reader.
usebroker=
[ "$role" = none ] && { role=; nobroker=1; }  # the old way to say --no-broker
if [ -n "$nobroker" ]; then
  [ ${#scopes[@]} -eq 0 ] && [ -z "$role" ] || { echo "apod: --role and --scope need the broker, which --no-broker turns off" >&2; exit 2; }
elif [ -n "$role" ] || [ ${#scopes[@]} -gt 0 ] || [ -f "$root/$profile/broker.toml" ]; then usebroker=1; fi
ghsecret=()
if [ -z "$usebroker" ]; then
  # GitHub token: the podman secret gh-<profile>, or another profile's if the github file names one.
  ghprofile=$profile
  if [ -f "$root/$profile/github" ]; then ghprofile=$(head -n1 "$root/$profile/github" | tr -d '[:space:]'); fi
  ghsecret=(--secret "gh-$ghprofile,type=env,target=GH_TOKEN")
  if ! podman secret exists "gh-$ghprofile"; then
    echo "apod: profile $ghprofile has no GitHub token, so gh and HTTPS pushes are unauthenticated. Use the broker (broker.toml, or --role dev) or add a token: apod token $ghprofile" >&2
    ghsecret=()
  else
    echo "apod: profile $profile uses a GitHub token; the broker is recommended instead (a broker.toml in the profile, see README)" >&2
  fi
fi
mkdir -p "$phome/.claude"
# SSH: the profile's ssh-key file names a private key (ideally passphrase-protected, kept outside
# the profile's home). It's served for this run by a dedicated ssh-agent on the host; the pod gets
# the agent socket, never the key file.
sshkey=
if [ -f "$root/$profile/ssh-key" ]; then
  sshkey=$(head -n1 "$root/$profile/ssh-key" | tr -d '[:space:]'); sshkey=${sshkey/#\~/$HOME}
  [ -f "$sshkey" ] || { echo "apod: $root/$profile/ssh-key points at a missing key: $sshkey" >&2; exit 2; }
fi

case $agent in
  claude)   cmd=(claude --permission-mode bypassPermissions) ;;
  opencode) cmd=(opencode) ;;  # permissions: see agentenv below
  bash)     cmd=(bash -l) ;;
  *) usage ;;
esac

# claude.ai connectors come with the Claude account, not the pod: off unless enabled with -c or
# the profile's connectors file (groups separated by commas, spaces or lines). -c replaces the
# file's groups for the run; "-c none" turns them all off.
if [ ${#connectors[@]} -eq 0 ] && [ -f "$root/$profile/connectors" ]; then
  while IFS=', ' read -ra cs; do connectors+=("${cs[@]}"); done < <(grep -v '^[[:space:]]*#' "$root/$profile/connectors")
fi
[ "${connectors[*]}" = none ] && connectors=()
ccloud=(); clocal=()  # claude.ai connector groups / local MCP servers
filemounts=()         # single files mounted over paths inside the extra mounts
for c in "${connectors[@]}"; do
  if [ -n "${connector_servers[$c]+x}" ]; then ccloud+=("$c")
  elif [[ " ${local_mcps[*]} " == *" $c "* ]]; then clocal+=("$c")
  else echo "apod: unknown connector '$c' (known: ${!connector_servers[*]} ${local_mcps[*]})" >&2; exit 2; fi
done
if [[ " ${ccloud[*]} " == *" gdoc "* && " ${clocal[*]} " == *" google-docs-mcp "* ]]; then
  echo "apod: use either gdoc or google-docs-mcp, not both (they overlap on Google Docs/Drive)" >&2; exit 2
fi
allowed=(); denied=()
for c in "${!connector_servers[@]}"; do
  for s in ${connector_servers[$c]}; do
    if [[ " ${ccloud[*]} " == *" $c "* ]]; then allowed+=("$s"); else denied+=("mcp__claude_ai_${s}__*"); fi
  done
done
if [ ${#allowed[@]} -eq 0 ]; then
  csettings='{"disableClaudeAiConnectors":true}'
else
  # Deny the known connectors not asked for (hides their tools) and, as a catch-all for
  # connectors not listed above, block any other claude.ai tool in a PreToolUse hook.
  re="^mcp__claude_ai_($(IFS='|'; echo "${allowed[*]}"))__"
  hook="t=\$(jq -r .tool_name); case \$t in mcp__claude_ai_*) echo \"\$t\" | grep -qE '$re' || { echo 'apod: connector not enabled for this run (apod -c)' >&2; exit 2; } ;; esac"
  csettings=$(jq -cn --arg hook "$hook" '$ARGS.positional as $deny
    | {permissions: {deny: $deny},
       hooks: {PreToolUse: [{matcher: "mcp__claude_ai_.*", hooks: [{type: "command", command: $hook}]}]}}' \
    --args "${denied[@]}")
fi
case $agent in
  claude) cmd+=(--settings "$csettings") ;;
  *) [ ${#connectors[@]} -eq 0 ] || echo "apod: -c only applies to claude; ignored for $agent" >&2; clocal=() ;;
esac
if [[ " ${clocal[*]} " == *" google-docs-mcp "* ]]; then
  [ -f "$gdocs_mcp/dist/index.js" ] || { echo "apod: google-docs-mcp isn't built: $gdocs_mcp/dist/index.js is missing" >&2; exit 2; }
  [ -f "$phome/.config/google-docs-mcp/token.json" ] || {
    echo "apod: profile $profile isn't signed in to Google. Run: apod google-auth $profile" >&2; exit 2; }
  climounts+=("ro $gdocs_mcp")
  [ -f "$root/$profile/google-credentials.json" ] &&
    filemounts+=(-v "$root/$profile/google-credentials.json:$gdocs_mcp/credentials.json:ro,z")
  cmd+=(--mcp-config "$(jq -cn --arg js "$gdocs_mcp/dist/index.js" --arg scopes "$gdocs_scopes" \
    '{mcpServers: {"google-docs-mcp": {command: "node", args: [$js],
      env: {GOOGLE_MCP_SCOPES: $scopes, MCP_LAZY_TOOLS: "1"}}}}')")
fi

# Session id for the history and apod resume: a new Claude run gets its own (--session-id), a
# --resume <id> run keeps that id; --continue, a bare --resume and other agents record none.
session=
if [ "$agent" = claude ]; then
  prev=; explicit=
  for a in "$@"; do
    case $a in --continue|-c|--resume|-r|--session-id) explicit=1 ;; esac
    case $prev in --resume|-r) [[ $a == -* ]] || session=$a ;; esac
    prev=$a
  done
  if [ -z "$explicit" ]; then session=$(uuidgen); cmd+=(--session-id "$session"); fi
fi

# Extra mounts: the profile's mounts file (one path per line, read-only unless prefixed "rw "),
# then --ro/--rw, which override the file's mode for the same path. Each path is mounted once.
declare -A mmode=(); morder=()
want_mount() {  # <ro|rw> <path>; fails if the path doesn't exist
  local path; path=$(realpath -m "${2/#\~/$HOME}")
  [ -e "$path" ] || return 1
  [ "$path" = "$proj" ] && return 0
  [ -n "${mmode[$path]+x}" ] || morder+=("$path")
  mmode[$path]=$1
}
if [ -f "$root/$profile/mounts" ]; then
  while read -r mode path; do
    case $mode in ''|'#'*) continue ;; rw|ro) ;; *) path=$mode; mode=ro ;; esac
    want_mount "$mode" "$path" || echo "apod: skipping missing mount $path" >&2
  done < "$root/$profile/mounts"
fi
for e in "${climounts[@]}"; do
  want_mount "${e%% *}" "${e#* }" || { echo "apod: no such path: ${e#* }" >&2; exit 2; }
done

# Extra mounts go before the project so a project nested inside a read-only tree stays writable.
mounts=(-v "$phome:/home/agent:z")
romounts=(); rwmounts=()
for path in "${morder[@]}"; do
  if [ "${mmode[$path]}" = rw ]; then rwmounts+=("$path"); mounts+=(-v "$path:$path:z")
  else romounts+=("$path"); mounts+=(-v "$path:$path:ro,z"); fi
done
mounts+=("${filemounts[@]}" -v "$proj:$proj:z")
# Share global agent instructions and skills read-only.
[ -f "$HOME/.claude/CLAUDE.md" ] && mounts+=(-v "$HOME/.claude/CLAUDE.md:/home/agent/.claude/CLAUDE.md:ro,z")
[ -d "$HOME/.claude/skills" ] && mounts+=(-v "$HOME/.claude/skills:/home/agent/.claude/skills:ro,z")

# Broker session: the broker reads the profile's broker.toml and env, and the project's remotes
# (GitHub and Radicle remotes join the scope), and answers with what the pod needs: mounts,
# environment, git config, keys to load into its agent, and a note for the agent.
bsid=; binfo=; bproviders=
if [ -n "$usebroker" ]; then
  regargs=(--id "$(uuidgen | tr -d - | cut -c1-12)" --profile "$profile" --profile-dir "$root/$profile" --project "$proj")
  [ -z "$role" ] || regargs+=(--role "$role")
  for s in "${scopes[@]}"; do regargs+=(--scope "$s"); done
  while read -r _ url; do regargs+=(--remote "$url"); done < <(git -C "$proj" config --get-regexp '^remote\..*\.(url|pushurl)$' 2>/dev/null || true)
  binfo=$(python3 "$apoddir/apod-broker" register "${regargs[@]}") || exit 2
  bsid=$(jq -r .id <<< "$binfo")
  bproviders=" $(jq -r '.providers | join(" ")' <<< "$binfo") "
  # Keys the broker's agent doesn't hold yet: ssh-add asks for their passphrases here.
  agentsock=$(jq -r .agent <<< "$binfo")
  while IFS=$'\t' read -r kpath kconfirm; do
    [ -n "$kpath" ] || continue
    addopts=(-q -t "${APOD_SSH_TTL:-4h}"); [ "$kconfirm" = true ] && addopts+=(-c)
    SSH_AUTH_SOCK=$agentsock ssh-add "${addopts[@]}" "$kpath" || echo "apod: couldn't load $kpath into the broker's agent" >&2
  done < <(jq -r '.need_keys[] | [.path, .confirm] | @tsv' <<< "$binfo")
  mounts+=(-v "$(jq -r .dir <<< "$binfo"):$(jq -r .pod_dir <<< "$binfo")"
    -v "$apoddir/broker/pod-shim:/usr/local/bin/apod-git-forward:ro")
  while IFS=$'\t' read -r src dst mode; do mounts+=(-v "$src:$dst:$mode"); done < <(jq -r '.mounts[] | @tsv' <<< "$binfo")
  if [[ $bproviders == *" ssh "* ]] && [ -n "$sshkey" ]; then
    echo "apod: broker.toml has [ssh], so the profile's ssh-key file is ignored" >&2; sshkey=
  fi
fi

# Tell the agent where it is and what it can see (Claude: appended to its system prompt).
context="You are running inside an apod container (podman), profile \"$profile\". Only these host paths are mounted:
- $proj (read-write, the project)"
for p in "${rwmounts[@]}"; do context+=$'\n'"- $p (read-write)"; done
for p in "${romounts[@]}"; do context+=$'\n'"- $p (read-only)"; done
if [ -n "$binfo" ]; then
  gh_note=$(jq -r .context <<< "$binfo")
elif [ ${#ghsecret[@]} -gt 0 ]; then gh_note="gh and git push over HTTPS use this profile's GitHub token."
else gh_note="This profile has no GitHub token: gh and HTTPS pushes are unauthenticated."; fi
context+=$'\n'"Nothing else from the host is available. There are no permission prompts: the container is the isolation boundary."
context+=$'\n'"$gh_note"
if [ ${#volpaths[@]} -gt 0 ]; then
  context+=$'\n'"Persistent volumes (kept between runs, not on the host filesystem): ${volpaths[*]}."
fi
if [ "$network" = host ]; then
  context+=$'\n'"Network: this pod shares the host's network (including Tailscale and services on the host's localhost)."
fi
if [ -n "$sshkey" ]; then
  context+=$'\n'"SSH: an ssh-agent on the host holds this profile's key (SSH_AUTH_SOCK); the key file itself isn't in the pod. Host aliases are in ~/.ssh/config."
fi
if [ ${#clocal[@]} -gt 0 ]; then
  context+=$'\n'"Local MCP servers enabled for this run: ${clocal[*]} (google-docs-mcp: Google Docs/Sheets/Slides/Drive as the profile's Google account). Servers from a project's .mcp.json that point at host paths won't start here."
fi
if [ ${#ccloud[@]} -gt 0 ]; then
  context+=$'\n'"claude.ai connectors enabled for this run: ${ccloud[*]}. Others are blocked."
else
  context+=$'\n'"claude.ai connectors (Notion, Google Docs, etc.) are disabled for this run; they can be enabled at launch with apod -c."
fi
if [ "$agent" = claude ]; then cmd+=(--append-system-prompt "$context"); fi

tty=(-i); [ -t 0 ] && tty+=(-t)

# Rewrite GitHub SSH remotes, including github-* host aliases from ~/.ssh/config, to HTTPS
# so pushes authenticate with the profile's token. Both git@host: and bare host: forms.
rewrites=(git@github.com: github.com: ssh://git@github.com/)
if [ -f "$HOME/.ssh/config" ]; then
  while read -r alias; do rewrites+=("git@$alias:" "$alias:" "ssh://git@$alias/"); done < <(
    awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i ~ /^github-/) print $i }' "$HOME/.ssh/config")
fi
gitenv=(-e "GIT_CONFIG_COUNT=${#rewrites[@]}")
for i in "${!rewrites[@]}"; do
  gitenv+=(-e "GIT_CONFIG_KEY_$i=url.https://github.com/.insteadOf" -e "GIT_CONFIG_VALUE_$i=${rewrites[$i]}")
done
benv=()
if [ -n "$binfo" ]; then
  # The broker's git config (its remotes' insteadOf, with {forward} filled in by the pod's wrapper,
  # signing) instead of the rewrites to HTTPS above; and its environment.
  n=0; gitenv=()
  while IFS=$'\t' read -r k v; do
    gitenv+=(-e "GIT_CONFIG_KEY_$n=$k" -e "GIT_CONFIG_VALUE_$n=$v"); n=$((n + 1))
  done < <(jq -r '.git_config[] | @tsv' <<< "$binfo")
  gitenv+=(-e "GIT_CONFIG_COUNT=$n")
  while IFS=$'\t' read -r k v; do benv+=(-e "$k=$v"); done < <(jq -r '.env | to_entries[] | [.key, .value] | @tsv' <<< "$binfo")
fi

# herdr only sees podman in the pane; tell it which agent's screen to read. Podman doesn't pass
# this into the container.
case $agent in claude|opencode) export HERDR_AGENT=$agent ;; esac

# Pods with a host socket (broker, ssh-key) run without SELinux labelling (below), so relabelling
# their mounts (:z) does nothing useful, and it fails on files you don't own.
if [ -n "$bsid" ] || [ -n "$sshkey" ]; then
  for i in "${!mounts[@]}"; do
    m=${mounts[$i]}; [ "$m" = -v ] && continue
    m=${m%:z}; m=${m/%,z/}; mounts[i]=$m
  done
fi
# No permission prompts, as for Claude (bypassPermissions): opencode allows most tools by default
# but asks before touching files outside the project, such as the profile's mounts. Its loop guard
# (doom_loop: the same call three times) still asks. The profile's env can set its own.
agentenv=()
if [ "$agent" = opencode ] && ! grep -q '^OPENCODE_PERMISSION=' "$envf"; then
  agentenv=(-e 'OPENCODE_PERMISSION={"external_directory":"allow"}')
fi
run=(podman run --rm "${tty[@]}" --userns=keep-id
  --name "apod-$profile-$(basename "$proj")-$$"
  --hostname "apod-$profile"
  "${ghsecret[@]}"
  --env-file "$envf"
  -e HOME=/home/agent
  -e APOD_PROFILE="$profile"
  -e CLAUDE_CODE_DISABLE_AGENT_VIEW=1
  "${gitenv[@]}" "${benv[@]}" "${agentenv[@]}"
  "${mounts[@]}" -w "$proj")
[ -z "$network" ] || run+=(--network "$network")
run+=("${volumes[@]}" --label apod.profile="$profile" --label apod.project="$proj" --label apod.session="$session")

# Remember this launch (apod history, apod resume).
printf '%s\0' "${recopts[@]}" | jq -cRs --argjson ts "$(date +%s)" --arg profile "$profile" \
  --arg agent "$agent" --arg project "$proj" --arg session "$session" --arg pane "$(pane_id)" \
  '{ts: $ts, profile: $profile, agent: $agent, project: $project,
    session: (if $session == "" then null else $session end), pane: (if $pane == "" then null else $pane end),
    opts: (split("\u0000") | .[:-1])}' \
  >> "$root/history.jsonl" || echo "apod: couldn't record this launch in the history" >&2
if [ -n "$bsid" ]; then
  # Start the git forwarder and put its URL where the broker's git config says {forward}, so
  # GitHub and Radicle remotes go through the broker.
  # shellcheck disable=SC2016 # expanded in the pod
  wrap='u=$(apod-git-forward) || { echo "apod: the git forwarder did not start; git cannot reach the broker" >&2; exec "$@"; }
for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do k=GIT_CONFIG_KEY_$i; v=${!k}; [[ $v == *"{forward}"* ]] && export "$k=${v//"{forward}"/$u}"; done
exec "$@"'
  cmdline=("$image" bash -lc "$wrap" _ "${cmd[@]}" "$@")
  # SELinux blocks a container from connecting to a host process's socket (as for ssh-agent).
  run+=(--security-opt label=disable --label apod.broker="$bsid")
else
  cmdline=("$image" bash -lc 'gh auth setup-git >/dev/null 2>&1 || true; exec "$@"' _ "${cmd[@]}" "$@")
fi
[ -n "$sshkey" ] || [ -n "$bsid" ] || exec "${run[@]}" "${cmdline[@]}"
agentpid=
cleanup() {
  [ -z "$agentpid" ] || kill "$agentpid" 2>/dev/null
  [ -z "${sock:-}" ] || rm -f "$sock"
  [ -z "$bsid" ] || python3 "$apoddir/apod-broker" unregister "$bsid" 2>/dev/null || true
}
trap cleanup EXIT
if [ -z "$sshkey" ]; then "${run[@]}" "${cmdline[@]}"; exit; fi

# Dedicated ssh-agent for this run: asks for the key's passphrase here, drops the key after
# $APOD_SSH_TTL (default 4h), confirms each use if the profile has an ssh-confirm file, and is
# killed when the pod exits. SELinux blocks a container from connecting to a host process's
# socket, so this pod runs without SELinux labelling (user namespace and mounts still apply).
adir=$root/$profile/agent; mkdir -p "$adir"; chmod 700 "$adir"
sock=$adir/ssh-$$.sock
eval "$(ssh-agent -a "$sock")" >/dev/null
agentpid=$SSH_AGENT_PID
addopts=(-t "${APOD_SSH_TTL:-4h}"); [ -f "$root/$profile/ssh-confirm" ] && addopts+=(-c)
SSH_AUTH_SOCK=$sock ssh-add -q "${addopts[@]}" "$sshkey"
"${run[@]}" -v "$adir:$adir" -e SSH_AUTH_SOCK="$sock" --security-opt label=disable "${cmdline[@]}"
