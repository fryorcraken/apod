#compdef apod
# zsh completion for apod. Link this file into a directory on $fpath,
# e.g. ln -s ~/src/rad/scripts/apod/_apod ~/.oh-my-zsh/custom/completions/_apod

_apod_profiles() {
  local -a profiles
  profiles=(${APOD_ROOT:-$HOME/.agent-pod}/*(N/:t))
  _describe -t profiles 'profile' profiles
}

_apod_first() {
  local -a cmds
  cmds=('token:set, replace or remove a profile GitHub token' 'profiles:list profiles and token status')
  _describe -t commands 'command' cmds
  _apod_profiles
}

_apod_images() {
  local -a images
  images=(${(f)"$(podman images --format '{{.Repository}}' 2>/dev/null | sed 's|^localhost/||' | sort -u)"})
  _describe -t images 'image' images
}

_apod_connectors() {
  local -a groups
  groups=(${(f)"$(apod --list-connectors 2>/dev/null)"})
  _values -s , 'connector' $groups
}

case ${words[2]} in
  token)    _arguments '1: :(token)' '2:profile:_apod_profiles' '3:option:(--rm)'; return ;;
  profiles) return ;;
esac

_arguments -s -S \
  '1:profile:_apod_first' \
  '2:project dir:_directories' \
  '-a[agent to run]:agent:(claude opencode bash)' \
  '(-i --image)'{-i,--image}'[container image for this run]:image:_apod_images' \
  '*'{-c,--connectors}'[enable claude.ai connectors for this run]:connectors:_apod_connectors' \
  '*'{-m,--ro}'[mount a file or folder read-only]:path:_files' \
  '*--rw[mount a file or folder read-write]:path:_files'
